{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["bun", "node"]
  },
  "include": [
    "scripts/**/*.ts",
    "integrations/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "native/target"]
}
