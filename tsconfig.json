{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["bun", "node"]
  },
  "include": ["scripts/integration-release.ts", "integrations/omp/**/*.ts"],
  "exclude": ["node_modules", "native-adapter/target"]
}
