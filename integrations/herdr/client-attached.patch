+    fn client_writer() -> (ClientWriter, std::sync::mpsc::Receiver<Vec<u8>>) {
+        let (control_tx, control_rx) = std::sync::mpsc::channel();
+        let (render_tx, _render_rx) = std::sync::mpsc::sync_channel(1);
+        (
+            ClientWriter::test_channel(control_tx, render_tx),
+            control_rx,
+        )
+    }
+
+    fn attached(hub: &api::EventHub) -> Vec<(u64, String)> {
+        hub.events_after(0)
+            .into_iter()
+            .filter_map(|(_, event)| match event.data {
+                EventData::ClientAttached {
+                    client_id,
+                    client_kind,
+                } => {
+                    assert_eq!(event.event, EventKind::ClientAttached);
+                    Some((client_id, client_kind))
+                }
+                _ => None,
+            })
+            .collect()
+    }
