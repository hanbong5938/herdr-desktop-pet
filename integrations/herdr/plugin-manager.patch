+            std::env::set_current_dir(&wrong_cwd).unwrap();
+            assert!(verify_manager_lease_lock_binding(&lease, &[]).is_err());
+            assert!(verify_manager_lease(token).is_err());
+            std::env::set_current_dir(&base).unwrap();
+            verify_manager_lease_lock_binding(&lease, &[]).unwrap();
+
+            let pet = base.join("pet");
