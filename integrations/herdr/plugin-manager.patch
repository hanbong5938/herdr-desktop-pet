+            params.action,
+            PluginManagerAction::Disable
+                | PluginManagerAction::Unlink
+                | PluginManagerAction::Uninstall
+        ) {
+            self.clear_agent_view_for_source(&format!("plugin:{}", params.expected.plugin_id));
+        }
+        encode_success(
+            id,
+            ResponseResult::PluginManagerMutation {
+                plugin_id: params.expected.plugin_id,
+                action: params.action,
+            },
+        )
+    }
+}
