+#[cfg(unix)]
+fn manager_open_at(
+    parent: &std::fs::File,
+    name: &std::ffi::CString,
+    flags: i32,
+    mode: libc::mode_t,
+) -> io::Result<std::fs::File> {
+    use std::os::fd::{AsRawFd, FromRawFd};
+    let fd = unsafe {
+        libc::openat(
+            parent.as_raw_fd(),
+            name.as_ptr(),
+            flags,
+            mode as libc::c_uint,
+        )
+    };
+    if fd < 0 {
+        Err(io::Error::last_os_error())
+    } else {
+        Ok(unsafe { std::fs::File::from_raw_fd(fd) })
+    }
+}
+
+#[cfg(unix)]
+fn manager_open_parent(
+    path: &Path,
+    config_identity: &ManagerConfigIdentity<'_>,
+) -> io::Result<std::fs::File> {
+    use std::os::fd::FromRawFd;
+    use std::os::unix::ffi::OsStrExt;
+    let fd = unsafe {
+        libc::open(
+            c"/".as_ptr(),
+            libc::O_RDONLY | libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_CLOEXEC,
+        )
+    };
+    if fd < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let mut dir = unsafe { std::fs::File::from_raw_fd(fd) };
+    let mut physical = PathBuf::from("/");
+    for component in path
+        .parent()
+        .ok_or_else(|| io::Error::other("missing registry parent"))?
+        .components()
+    {
+        let std::path::Component::Normal(name) = component else {
+            continue;
+        };
+        let name = std::ffi::CString::new(name.as_bytes())
+            .map_err(|_| io::Error::other("invalid registry directory"))?;
+        manager_verify_parent(&dir, &physical)?;
+        config_identity.verify()?;
+        let child = match manager_open_at(
+            &dir,
+            &name,
+            libc::O_RDONLY | libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_CLOEXEC,
+            0,
+        ) {
+            Ok(child) => child,
+            Err(err) if err.kind() == io::ErrorKind::NotFound => {
+                config_identity.verify()?;
+                use std::os::fd::AsRawFd;
+                if unsafe { libc::mkdirat(dir.as_raw_fd(), name.as_ptr(), 0o700) } != 0 {
+                    return Err(io::Error::last_os_error());
+                }
+                manager_open_at(
+                    &dir,
+                    &name,
+                    libc::O_RDONLY | libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_CLOEXEC,
+                    0,
+                )?
+            }
+            Err(err) => return Err(err),
+        };
+        physical.push(std::ffi::OsStr::from_bytes(name.as_bytes()));
+        manager_verify_parent(&child, &physical)?;
+        config_identity.verify()?;
+        // Existing links may have been created by startup, guard admission or
+        // an ordinary writer. Seal every necessary edge, not only our mkdirat.
+        manager_sync(&dir, ManagerSyncStage::Ancestor)?;
+        dir = child;
+    }
+    Ok(dir)
+}
+
+#[cfg(unix)]
+fn manager_verify_parent(dir: &std::fs::File, path: &Path) -> io::Result<()> {
+    use std::os::unix::fs::MetadataExt;
+    let metadata = std::fs::metadata(path)?;
+    let pinned = dir.metadata()?;
+    if metadata.dev() != pinned.dev() || metadata.ino() != pinned.ino() {
+        return Err(io::Error::other("plugin registry parent changed"));
+    }
+    Ok(())
+}
+
+#[cfg(unix)]
+fn manager_rename_at(
+    dir: &std::fs::File,
+    from: &std::ffi::CString,
+    to: &std::ffi::CString,
+) -> io::Result<()> {
+    use std::os::fd::AsRawFd;
+    if unsafe { libc::renameat(dir.as_raw_fd(), from.as_ptr(), dir.as_raw_fd(), to.as_ptr()) } == 0
+    {
+        Ok(())
+    } else {
+        Err(io::Error::last_os_error())
+    }
+}
+
+#[cfg(unix)]
+fn manager_unlink_at(dir: &std::fs::File, name: &std::ffi::CString) -> io::Result<()> {
+    use std::os::fd::AsRawFd;
+    if unsafe { libc::unlinkat(dir.as_raw_fd(), name.as_ptr(), 0) } == 0 {
+        Ok(())
+    } else {
+        Err(io::Error::last_os_error())
+    }
+}
