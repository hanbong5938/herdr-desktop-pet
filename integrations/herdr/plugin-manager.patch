+#[cfg(target_os = "macos")]
+fn manager_peer_identity(stream: &LocalStream) -> Result<(u32, PathBuf), ApiClientError> {
+    #[link(name = "proc")]
+    unsafe extern "C" {
+        fn proc_pidpath(pid: libc::c_int, buffer: *mut libc::c_void, size: u32) -> libc::c_int;
+    }
+    let LocalStream::UdSocket(stream) = stream;
+    let fd = stream.inner().as_raw_fd();
+    let mut pid: libc::pid_t = 0;
+    let mut size = std::mem::size_of_val(&pid) as libc::socklen_t;
+    if unsafe {
+        libc::getsockopt(
+            fd,
+            libc::SOL_LOCAL,
+            libc::LOCAL_PEERPID,
+            (&mut pid as *mut libc::pid_t).cast(),
+            &mut size,
+        )
+    } != 0
+        || size as usize != std::mem::size_of_val(&pid)
+        || pid <= 0
+    {
+        return Err(ApiClientError::UnexpectedResult(
+            "cannot authenticate server PID".into(),
+        ));
+    }
+    let (mut uid, mut gid) = (0, 0);
+    if unsafe { libc::getpeereid(fd, &mut uid, &mut gid) } != 0 || uid != unsafe { libc::geteuid() }
+    {
+        return Err(ApiClientError::UnexpectedResult(
+            "server socket peer is not the current user".into(),
+        ));
+    }
+    let mut buffer = [0u8; 4096];
+    let len = unsafe { proc_pidpath(pid, buffer.as_mut_ptr().cast(), buffer.len() as u32) };
+    if len <= 0 || len as usize > buffer.len() {
+        return Err(ApiClientError::UnexpectedResult(
+            "cannot identify server executable".into(),
+        ));
+    }
+    use std::os::unix::ffi::OsStrExt;
+    let end = buffer[..len as usize]
+        .iter()
+        .position(|byte| *byte == 0)
+        .unwrap_or(len as usize);
+    let path = Path::new(std::ffi::OsStr::from_bytes(&buffer[..end])).canonicalize()?;
+    Ok((pid as u32, path))
+}
+
+#[cfg(target_os = "linux")]
+fn manager_peer_identity(stream: &LocalStream) -> Result<(u32, PathBuf), ApiClientError> {
+    let LocalStream::UdSocket(stream) = stream;
+    let mut credentials: libc::ucred = unsafe { std::mem::zeroed() };
+    let mut size = std::mem::size_of_val(&credentials) as libc::socklen_t;
+    if unsafe {
+        libc::getsockopt(
+            stream.inner().as_raw_fd(),
+            libc::SOL_SOCKET,
+            libc::SO_PEERCRED,
+            (&mut credentials as *mut libc::ucred).cast(),
+            &mut size,
+        )
+    } != 0
+        || size as usize != std::mem::size_of_val(&credentials)
+        || credentials.pid <= 0
+        || credentials.uid != unsafe { libc::geteuid() }
+    {
+        return Err(ApiClientError::UnexpectedResult(
+            "cannot authenticate same-user server peer".into(),
+        ));
+    }
+    let executable = PathBuf::from(format!("/proc/{}/exe", credentials.pid)).canonicalize()?;
+    Ok((credentials.pid as u32, executable))
+}
+
+#[cfg(not(any(target_os = "macos", target_os = "linux")))]
+fn manager_peer_identity(_: &LocalStream) -> Result<(u32, PathBuf), ApiClientError> {
+    Err(ApiClientError::UnexpectedResult(
+        "manager peer authentication requires macOS or Linux".into(),
+    ))
+}
