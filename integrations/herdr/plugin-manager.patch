+#[cfg(unix)]
+fn guarded_roots(protected_roots: &[String]) -> io::Result<Vec<PathBuf>> {
+    protected_roots
+        .iter()
+        .map(|root| resolved(Path::new(root)))
+        .collect()
+}
+
+#[cfg(unix)]
+fn guarded_location(
+    logical_dir: &Path,
+    protected_roots: &[String],
+    name: &str,
+) -> io::Result<PathBuf> {
+    let dir = resolved(logical_dir)?;
+    let leaf = dir.join(name);
+    for root in guarded_roots(protected_roots)? {
+        if dir.starts_with(&root) || leaf.starts_with(&root) || root.starts_with(&leaf) {
+            return Err(io::Error::other(
+                "manager lock overlaps protected installation",
+            ));
+        }
+    }
+    Ok(dir)
+}
+
+#[cfg(unix)]
+fn guarded_physical_directory(
+    dir: &Path,
+    protected_roots: &[String],
+    create: bool,
+) -> io::Result<std::fs::File> {
+    use std::os::fd::{AsRawFd, FromRawFd};
+    use std::os::unix::ffi::OsStrExt;
+    use std::os::unix::fs::MetadataExt;
+
+    let roots = guarded_roots(protected_roots)?;
+    let mut current = PathBuf::from("/");
+    let mut parent = std::fs::File::open("/")?;
+    for component in dir.components() {
+        let std::path::Component::Normal(name) = component else {
+            continue;
+        };
+        current.push(name);
+        if roots.iter().any(|root| current.starts_with(root)) {
+            return Err(io::Error::other(
+                "manager lock directory overlaps protected installation",
+            ));
+        }
+        let name = std::ffi::CString::new(name.as_bytes())
+            .map_err(|_| io::Error::other("invalid manager lock directory"))?;
+        let flags = libc::O_RDONLY | libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_CLOEXEC;
+        let mut fd = unsafe { libc::openat(parent.as_raw_fd(), name.as_ptr(), flags) };
+        if create && fd < 0 && io::Error::last_os_error().kind() == io::ErrorKind::NotFound {
+            if unsafe { libc::mkdirat(parent.as_raw_fd(), name.as_ptr(), 0o700) } != 0 {
+                let err = io::Error::last_os_error();
+                if err.kind() != io::ErrorKind::AlreadyExists {
+                    return Err(err);
+                }
+            }
+            // Seal the newly created directory link before creating anything
+            // deeper. Reused ancestors are sealed by the registry transaction.
+            parent.sync_all()?;
+            fd = unsafe { libc::openat(parent.as_raw_fd(), name.as_ptr(), flags) };
+        }
+        if fd < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        let next = unsafe { std::fs::File::from_raw_fd(fd) };
+        let anchored = next.metadata()?;
+        let named = std::fs::metadata(&current)?;
+        if anchored.dev() != named.dev() || anchored.ino() != named.ino() {
+            return Err(io::Error::other("manager lock directory changed"));
+        }
+        parent = next;
+    }
+    Ok(parent)
+}
+
+#[cfg(unix)]
+fn check_guarded_binding(
+    parent: &std::fs::File,
+    file: &std::fs::File,
+    logical_dir: &Path,
+    name: &str,
+    protected_roots: &[String],
+) -> io::Result<()> {
+    use std::os::fd::AsRawFd;
+    use std::os::unix::fs::MetadataExt;
+
+    let dir = guarded_location(logical_dir, protected_roots, name)?;
+    let named_dir = std::fs::metadata(&dir)?;
+    let anchored_dir = parent.metadata()?;
+    let named_logical_dir = std::fs::metadata(logical_dir)?;
+    if named_dir.dev() != anchored_dir.dev()
+        || named_dir.ino() != anchored_dir.ino()
+        || named_logical_dir.dev() != anchored_dir.dev()
+        || named_logical_dir.ino() != anchored_dir.ino()
+    {
+        return Err(io::Error::other("manager lock directory changed"));
+    }
+    let leaf =
+        std::ffi::CString::new(name).map_err(|_| io::Error::other("invalid manager lock name"))?;
+    let mut named = std::mem::MaybeUninit::<libc::stat>::uninit();
+    if unsafe {
+        libc::fstatat(
+            parent.as_raw_fd(),
+            leaf.as_ptr(),
+            named.as_mut_ptr(),
+            libc::AT_SYMLINK_NOFOLLOW,
+        )
+    } != 0
+    {
+        return Err(io::Error::last_os_error());
+    }
+    let named = unsafe { named.assume_init() };
+    let anchored = file.metadata()?;
+    if !anchored.is_file()
+        || anchored.nlink() != 1
+        || anchored.uid() != unsafe { libc::geteuid() }
+        || anchored.dev() != named.st_dev as u64
+        || anchored.ino() != named.st_ino
+        || named.st_mode & libc::S_IFMT != libc::S_IFREG
+    {
+        return Err(io::Error::other("manager lock file changed or is unsafe"));
+    }
+    Ok(())
+}
+
+#[cfg(unix)]
+fn lock_manager_file_guarded(name: &str, protected_roots: &[String]) -> io::Result<std::fs::File> {
+    lock_manager_file_guarded_in(&manager_managed_plugins_dir()?, name, protected_roots)
+}
+
+#[cfg(unix)]
+fn lock_manager_file_guarded_in(
+    logical_dir: &Path,
+    name: &str,
+    protected_roots: &[String],
+) -> io::Result<std::fs::File> {
+    use std::os::fd::{AsRawFd, FromRawFd};
+
+    let dir = guarded_location(logical_dir, protected_roots, name)?;
+    let parent = guarded_physical_directory(&dir, protected_roots, true)?;
+    let physical_dir = guarded_location(logical_dir, protected_roots, name)?;
+    if dir != physical_dir {
+        return Err(io::Error::other("manager lock directory changed"));
+    }
+    let leaf =
+        std::ffi::CString::new(name).map_err(|_| io::Error::other("invalid manager lock name"))?;
+    let fd = unsafe {
+        libc::openat(
+            parent.as_raw_fd(),
+            leaf.as_ptr(),
+            libc::O_CREAT | libc::O_RDWR | libc::O_NOFOLLOW | libc::O_CLOEXEC,
+            0o600,
+        )
+    };
+    if fd < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let file = unsafe { std::fs::File::from_raw_fd(fd) };
+    check_guarded_binding(&parent, &file, logical_dir, name, protected_roots)?;
+    if unsafe { libc::flock(file.as_raw_fd(), libc::LOCK_EX) } != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    check_guarded_binding(&parent, &file, logical_dir, name, protected_roots)?;
+    Ok(file)
+}
+
+#[cfg(unix)]
+pub(crate) fn verify_manager_lease_lock_binding(
+    file: &std::fs::File,
+    protected_roots: &[String],
+) -> io::Result<()> {
+    let logical_dir = manager_managed_plugins_dir()?;
+    let dir = guarded_location(&logical_dir, protected_roots, ".manager.lock")?;
+    let parent = guarded_physical_directory(&dir, protected_roots, false)?;
+    check_guarded_binding(
+        &parent,
+        file,
+        &logical_dir,
+        ".manager.lock",
+        protected_roots,
+    )
+}
+
+/// Ordinary server mutations take this nonblocking lock. The Manager holds it
+/// throughout a filesystem transaction; its own server mutation intentionally
+/// uses the registry lock instead to avoid waiting on itself.
+#[cfg(unix)]
+pub(crate) fn try_ordinary_mutation_admission() -> io::Result<std::fs::File> {
+    try_ordinary_mutation_admission_in(&crate::plugin_paths::managed_plugins_dir())
+}
+
+#[cfg(unix)]
+fn try_ordinary_mutation_admission_in(dir: &Path) -> io::Result<std::fs::File> {
+    std::fs::create_dir_all(dir)?;
+    let mut options = std::fs::OpenOptions::new();
+    options.create(true).read(true).write(true);
+    use std::os::unix::fs::OpenOptionsExt;
+    options.mode(0o600);
+    let file = options.open(dir.join(".manager.lock"))?;
+    if unsafe {
+        libc::flock(
+            std::os::fd::AsRawFd::as_raw_fd(&file),
+            libc::LOCK_EX | libc::LOCK_NB,
+        )
+    } != 0
+    {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(file)
+}
+
+/// A server-side manager mutation is admitted only while the CLI's lease is
+/// live. Ordinary requests cannot claim this bypass without its lease token.
+#[cfg(not(unix))]
+pub(crate) fn verify_manager_lease(_token: &str) -> io::Result<()> {
+    Err(io::Error::new(
+        io::ErrorKind::Unsupported,
+        "plugin manager mutations require a Unix host",
+    ))
+}
+
+#[cfg(unix)]
+pub(crate) fn verify_manager_lease(token: &str) -> io::Result<()> {
+    if token.len() != 32 || !token.bytes().all(|byte| byte.is_ascii_hexdigit()) {
+        return Err(io::Error::other("invalid manager lease token"));
+    }
+    let path = manager_managed_plugins_dir()?.join(".manager.lock");
+    let mut options = std::fs::OpenOptions::new();
+    options.read(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC);
+    }
+    let file = options.open(path)?;
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        let metadata = file.metadata()?;
+        if !metadata.is_file()
+            || metadata.uid() != unsafe { libc::geteuid() }
+            || metadata.mode() & 0o077 != 0
+            || metadata.nlink() != 1
+        {
+            return Err(io::Error::other("unsafe manager lease file"));
+        }
+        if unsafe {
+            libc::flock(
+                std::os::fd::AsRawFd::as_raw_fd(&file),
+                libc::LOCK_EX | libc::LOCK_NB,
+            )
+        } == 0
+        {
+            return Err(io::Error::other("manager lease is not held"));
+        }
+        let error = io::Error::last_os_error();
+        if error.kind() != io::ErrorKind::WouldBlock {
+            return Err(error);
+        }
+    }
+    use std::io::Read;
+    let mut contents = String::new();
+    file.take(128).read_to_string(&mut contents)?;
+    let mut fields = contents.split_whitespace();
+    let pid = fields
+        .next()
+        .and_then(|value| value.parse::<i32>().ok())
+        .filter(|pid| *pid > 0)
+        .ok_or_else(|| io::Error::other("invalid manager lease owner"))?;
+    if fields.next() != Some(token) || fields.next().is_some() {
+        return Err(io::Error::other("manager lease token does not match"));
+    }
+    #[cfg(unix)]
+    if unsafe { libc::kill(pid, 0) } != 0 {
+        return Err(io::Error::other("manager lease owner is not running"));
+    }
+    Ok(())
+}
