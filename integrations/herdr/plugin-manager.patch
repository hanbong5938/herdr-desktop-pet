+    #[test]
+    fn install_lock_blocks_competing_checkout_until_held_file_is_dropped() {
+        use std::sync::mpsc;
+        use std::time::Duration;
+
+        let dir = std::env::temp_dir().join(format!(
+            "herdr-install-lock-contention-{}",
+            std::process::id()
+        ));
+        let held = lock_install_roots_in(&dir).unwrap();
+        let (attempted_tx, attempted_rx) = mpsc::channel();
+        let (acquired_tx, acquired_rx) = mpsc::channel();
+        let contender_dir = dir.clone();
+        let contender = std::thread::spawn(move || {
+            attempted_tx.send(()).unwrap();
+            let acquired = lock_install_roots_in(&contender_dir).unwrap();
+            acquired_tx.send(()).unwrap();
+            drop(acquired);
+        });
+        attempted_rx.recv_timeout(Duration::from_secs(3)).unwrap();
+        assert!(matches!(
+            acquired_rx.recv_timeout(Duration::from_millis(100)),
+            Err(mpsc::RecvTimeoutError::Timeout)
+        ));
+        drop(held);
+        acquired_rx.recv_timeout(Duration::from_secs(3)).unwrap();
+        contender.join().unwrap();
+        std::fs::remove_dir_all(dir).unwrap();
+    }
