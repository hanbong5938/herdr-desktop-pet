+/// Serialize changes to managed checkouts across ordinary CLI commands and
+/// Manager transactions. The returned file owns the lock until it is dropped.
+pub(crate) fn lock_install_roots() -> io::Result<std::fs::File> {
+    lock_install_roots_in(&crate::plugin_paths::managed_plugins_dir())
