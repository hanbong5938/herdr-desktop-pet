+/// A manager-only transaction bound to the immutable, canonical config root
+/// captured by the request. The config identity is independent of a stow-managed
+/// registry destination and stays pinned through callback and commit checks.
+pub fn update_checked_guarded<T, E>(
+    expected_config: &Path,
+    protected_roots: &[String],
+    mutation: impl FnOnce(&mut Vec<InstalledPluginInfo>) -> Result<T, E>,
+) -> Result<Result<(T, Vec<InstalledPluginInfo>), E>, ManagerRegistryError> {
+    #[cfg(not(unix))]
+    {
+        let _ = (expected_config, protected_roots, mutation);
+        return Err(io::Error::other("plugin manager requires a Unix host").into());
+    }
+    #[cfg(unix)]
+    {
+        let config = crate::plugin_manager_guard::manager_config_dir()?;
+        manager_update_at(
+            &config.join("plugins.json"),
+            &config.join(REGISTRY_LOCK_FILE),
+            expected_config,
+            protected_roots,
+            mutation,
+        )
+    }
+}
