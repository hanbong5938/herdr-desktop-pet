+                    .get(&params.expected.plugin_id)
+                    .ok_or("plugin registration no longer exists".to_string())?;
+                if current != &params.expected_registration {
+                    return Err("plugin registration changed since confirmation".to_string());
+                }
+                match params.action {
+                    PluginManagerAction::Update | PluginManagerAction::Uninstall
+                        if current.source.kind != PluginSourceKind::Github =>
+                    {
+                        return Err("operation requires a managed GitHub plugin".to_string());
+                    }
+                    PluginManagerAction::Unlink
+                        if current.source.kind != PluginSourceKind::Local =>
+                    {
+                        return Err("operation requires a locally linked plugin".to_string());
+                    }
+                    _ => {}
+                }
+                let mut paths = registration_paths(current);
+                paths.extend(registration_paths(&params.expected));
+                if let Some(candidate) = replacement.as_ref() {
+                    paths.extend(registration_paths(candidate));
+                }
+                if let Some(update) = params.replacement.as_ref() {
+                    paths.push(Path::new(&update.previous_checkout));
+                    paths.push(Path::new(&update.path));
+                }
+                ensure_safe(
+                    &current.plugin_id,
+                    &paths,
+                    &registrations,
+                    &params.protected_roots,
+                )
+                .map_err(|err| err.to_string())?;
+                let displayed = if params.action == PluginManagerAction::Update {
+                    let update = params.replacement.as_ref().unwrap();
+                    let (displayed, backup, manifest) = previous_manifest(current, update)?;
+                    ensure_safe(
+                        &current.plugin_id,
+                        &[backup.as_path(), manifest.as_path()],
+                        &registrations,
+                        &params.protected_roots,
+                    )
+                    .map_err(|err| err.to_string())?;
+                    displayed
+                } else {
+                    confirmed_display(current)
+                };
+                if displayed != params.expected {
+                    return Err("plugin display changed since confirmation".to_string());
+                }
+                let replacement_final = if let Some(update) = params.replacement.as_ref() {
+                    let mut fresh = load_plugin_manifest(&update.path, current.enabled)
+                        .map_err(|(_, message)| message)?;
+                    fresh.source = normalize_plugin_source(&fresh, update.source.clone())
+                        .map_err(|(_, message)| message)?;
+                    let checkout = current
+                        .source
+                        .managed_path
+                        .as_deref()
+                        .ok_or("missing recorded managed checkout")?;
+                    let expected_root = managed_manifest_root(
+                        Path::new(checkout),
+                        current.source.subdir.as_deref(),
+                    )
+                    .map_err(|err| err.to_string())?;
+                    ensure_installed_manifest_matches_checkout(&fresh, &expected_root)
+                        .map_err(|err| err.to_string())?;
+                    if Some(&fresh) != replacement.as_ref() {
+                        return Err("replacement changed during confirmation".to_string());
+                    }
+                    ensure_safe(
+                        &current.plugin_id,
+                        &registration_paths(&fresh),
+                        &registrations,
+                        &params.protected_roots,
+                    )
+                    .map_err(|err| err.to_string())?;
+                    Some(fresh)
+                } else {
+                    None
+                };
+                let current_id = current.plugin_id.clone();
+                match params.action {
+                    PluginManagerAction::Enable | PluginManagerAction::Disable => {
+                        entries.get_mut(&current_id).unwrap().enabled =
+                            params.action == PluginManagerAction::Enable;
+                    }
+                    PluginManagerAction::Unlink | PluginManagerAction::Uninstall => {
+                        entries.remove(&current_id);
+                    }
+                    PluginManagerAction::Update => {
+                        entries.insert(current_id, replacement_final.unwrap());
+                    }
+                }
+                Ok(())
+            },
+        );
+        match checked {
+            Err(ManagerRegistryError::PreCommit(err)) => {
+                return encode_error(id, "plugin_manager_registry_failed", err.to_string());
+            }
+            Err(ManagerRegistryError::CommitUnknown(err)) => {
+                return encode_error(id, "plugin_manager_registry_uncertain", err.to_string());
+            }
+            Ok(Err(err)) => return encode_error(id, "plugin_manager_rejected", err),
+            Ok(Ok(())) => {}
+        }
+        if matches!(
+            params.action,
+            PluginManagerAction::Unlink | PluginManagerAction::Uninstall
+        ) {
+            self.state
+                .plugin_panes
+                .retain(|_, record| record.plugin_id != params.expected.plugin_id);
