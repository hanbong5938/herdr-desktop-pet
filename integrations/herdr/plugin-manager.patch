+/// Anchor only the configuration producer; arbitrary stored and protected paths
+/// still pass through the absolute-only resolver below.
+pub(crate) fn manager_config_dir() -> io::Result<PathBuf> {
+    std::path::absolute(crate::config::config_dir())
