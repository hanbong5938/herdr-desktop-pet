+#[cfg(unix)]
+fn manager_safe_paths(
+    target: &Path,
+    lock: &Path,
+    temp: &Path,
+    raw: &[InstalledPluginInfo],
+    supplied_roots: &[String],
+) -> io::Result<()> {
+    if supplied_roots.is_empty() || supplied_roots.iter().any(String::is_empty) {
+        return Err(io::Error::other("missing desktop-pet protection roots"));
+    }
+    let legacy_temp = target.with_extension("json.tmp");
+    let mut paths = vec![target, lock, temp, legacy_temp.as_path()];
+    for parent in [target.parent(), lock.parent()].into_iter().flatten() {
+        if std::fs::symlink_metadata(parent).is_err_and(|err| err.kind() == io::ErrorKind::NotFound)
+        {
+            paths.push(parent);
+        }
+    }
+    crate::plugin_manager_guard::ensure_safe("plugin-registry", &paths, raw, supplied_roots)
+}
