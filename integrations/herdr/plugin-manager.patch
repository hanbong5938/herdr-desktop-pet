+                let registry = config.join("plugins.json");
+                crate::persist::plugin_registry::save_to_path(&registry, &[plugin.clone()])
+                    .unwrap();
+                let before = fs::read(&registry).unwrap();
+                let user_config = crate::plugin_paths::plugin_config_dir(&plugin.plugin_id);
+                let user_state = crate::plugin_paths::plugin_state_dir(&plugin.plugin_id);
+                fs::create_dir_all(&user_config).unwrap();
