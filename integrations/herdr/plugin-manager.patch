+pub(crate) fn ensure_installed_manifest_matches_checkout(
+    plugin: &InstalledPluginInfo,
+    expected_root: &Path,
+) -> io::Result<()> {
+    // The loader exposes a native runtime root on Windows, but keeps the manifest canonical.
+    // Only normalize the canonical expected root; retain exact source/manifest containment.
+    if Path::new(&plugin.plugin_root) != crate::platform::plugin_runtime_path(expected_root)
+        || Path::new(&plugin.manifest_path) != expected_root.join("herdr-plugin.toml")
+    {
+        return Err(io::Error::other(
+            "installed plugin manifest does not match the managed checkout source",
+        ));
+    }
+    Ok(())
+}
