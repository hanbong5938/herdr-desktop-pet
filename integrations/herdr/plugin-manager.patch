+/// A failed directory barrier after rename cannot prove that the old registry
+/// remains authoritative. Keep that outcome separate from definite rejection.
+#[derive(Debug)]
+pub enum ManagerRegistryError {
+    PreCommit(io::Error),
+    CommitUnknown(io::Error),
+}
+
+impl From<io::Error> for ManagerRegistryError {
+    fn from(error: io::Error) -> Self {
+        Self::PreCommit(error)
+    }
+}
+
+impl std::fmt::Display for ManagerRegistryError {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::PreCommit(error) => std::fmt::Display::fmt(error, formatter),
+            Self::CommitUnknown(error) => write!(
+                formatter,
+                "registry rename may have taken effect; durability is unconfirmed: {error}"
+            ),
+        }
+    }
+}
+
+impl std::error::Error for ManagerRegistryError {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        Some(match self {
+            Self::PreCommit(error) | Self::CommitUnknown(error) => error,
+        })
+    }
+}
