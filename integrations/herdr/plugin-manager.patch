+/// Read-only physical write surfaces for the CLI's preflight. The guarded
+/// transaction independently rechecks and pins them before any write.
+pub fn manager_write_paths() -> io::Result<Vec<PathBuf>> {
+    let config = crate::plugin_manager_guard::manager_config_dir()?;
+    let registry = config.join("plugins.json");
+    let lock_alias = config.join(REGISTRY_LOCK_FILE);
+    let target = manager_physical_path(&resolve_write_target(&registry)?)?;
+    let lock = manager_physical_path(&lock_alias)?;
+    let mut paths = vec![
+        registry,
+        target.clone(),
+        target.with_extension("json.tmp"),
+        lock,
+    ];
+    for parent in [target.parent(), lock_alias.parent()].into_iter().flatten() {
+        if std::fs::symlink_metadata(parent).is_err_and(|err| err.kind() == io::ErrorKind::NotFound)
+        {
+            paths.push(manager_physical_path(parent)?);
+        }
+    }
+    Ok(paths)
+}
+
+/// Resolve an existing ancestor and append missing components. A dangling
+/// symlink (including a missing registry alias target) cannot be silently
+/// treated as an ordinary missing directory.
+fn manager_physical_path(path: &Path) -> io::Result<PathBuf> {
+    if !path.is_absolute() {
+        return Err(io::Error::other("manager registry path is not absolute"));
+    }
+    let mut missing = Vec::new();
+    let mut ancestor = path;
+    loop {
+        match std::fs::symlink_metadata(ancestor) {
+            Ok(_) => break,
+            Err(err) if err.kind() == io::ErrorKind::NotFound => {
+                let component = ancestor
+                    .file_name()
+                    .ok_or_else(|| io::Error::other("invalid registry path"))?;
+                if component == "." || component == ".." {
+                    return Err(io::Error::other("noncanonical registry target"));
+                }
+                missing.push(component.to_owned());
+                ancestor = ancestor
+                    .parent()
+                    .ok_or_else(|| io::Error::other("invalid registry path"))?;
+            }
+            Err(err) => return Err(err),
+        }
+    }
+    let mut physical = ancestor.canonicalize()?;
+    for component in missing.iter().rev() {
+        physical.push(component);
+    }
+    Ok(physical)
+}
