+    fn temp_root(label: &str) -> PathBuf {
+        let nonce = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .unwrap()
+            .as_nanos();
+        std::env::temp_dir().join(format!(
+            "herdr-manager-{label}-{}-{nonce}",
+            std::process::id(),
+        ))
+    }
+
+    fn write_manifest(root: &Path, name: &str, version: &str) {
+        std::fs::create_dir_all(root).unwrap();
+        std::fs::write(
+            root.join("herdr-plugin.toml"),
+            format!(
+                "id = 'example.manager'\nname = '{name}'\nversion = '{version}'\nmin_herdr_version = '0.9.3'\nplatforms = ['macos']\n"
+            ),
+        )
+        .unwrap();
+    }
+
+    #[test]
+    fn confirmed_display_accepts_preopen_manifest_changes_and_rejects_later_changes() {
+        let root = temp_root("confirmed-display");
+        write_manifest(&root, "Stored", "1.0.0");
+        let raw = load_plugin_manifest(&root.display().to_string(), false).unwrap();
+        write_manifest(&root, "Before Open", "2.0.0");
+        let expected = confirmed_display(&raw);
+        assert_eq!(expected.name, "Before Open");
+        assert_eq!(expected.version, "2.0.0");
+        assert_ne!(expected, raw);
+        assert_eq!(confirmed_display(&raw), expected);
+        write_manifest(&root, "After Confirmation", "3.0.0");
+        assert_ne!(confirmed_display(&raw), expected);
+        std::fs::remove_dir_all(root).unwrap();
+    }
+
+    #[test]
+    fn update_display_preserves_scoped_space_subdirectory_and_rejects_changed_backup() {
+        let root = temp_root("backup-metadata");
+        let managed = root.join("managed");
+        let prior_root = managed.join("@scope/space plugin");
+        write_manifest(&prior_root, "Cached", "1.0.0");
+        let mut raw = load_plugin_manifest(&prior_root.display().to_string(), false).unwrap();
+        raw.source.kind = PluginSourceKind::Github;
+        raw.source.owner = Some("owner".into());
+        raw.source.repo = Some("repo".into());
+        raw.source.subdir = Some("@scope/space plugin".into());
+        raw.source.requested_ref = Some("release".into());
+        raw.source.resolved_commit = Some("abc123".into());
+        raw.source.managed_path = Some(managed.display().to_string());
+        raw.source.installed_unix_ms = Some(42);
+        write_manifest(&prior_root, "Confirmed Old", "2.0.0");
+        let expected = confirmed_display(&raw);
+        let backup = root.join("previous-checkout");
+        std::fs::rename(&managed, &backup).unwrap();
+        write_manifest(&prior_root, "New Candidate", "3.0.0");
+        let update = PluginManagerReplacement {
+            path: prior_root.display().to_string(),
+            previous_checkout: backup.display().to_string(),
+            source: raw.source.clone(),
