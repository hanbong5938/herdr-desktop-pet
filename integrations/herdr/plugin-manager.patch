+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Operation {
+    protocol: u32,
+    operation_id: String,
+    action: PluginManagerAction,
+    socket: String,
+    host: String,
+    context: PluginManagerContextBinding,
+    expected: InstalledPluginInfo,
+    expected_registration: InstalledPluginInfo,
+    protected_roots: Vec<String>,
+}
+#[derive(Debug)]
+struct Failure {
+    status: &'static str,
+    detail: String,
+}
+
+impl Failure {
+    fn failed(detail: impl ToString) -> Self {
+        Self {
+            status: "failed",
+            detail: detail.to_string(),
+        }
+    }
+    fn unknown(detail: impl ToString) -> Self {
+        Self {
+            status: "unknown",
+            detail: detail.to_string(),
+        }
+    }
+    fn partial(detail: impl ToString) -> Self {
+        Self {
+            status: "partial",
+            detail: detail.to_string(),
+        }
+    }
+}
+
+fn request(
+    client: &ApiClient,
+    method: Method,
+    expected_pid: Option<u32>,
+    host: &Path,
+) -> Result<(ResponseResult, u32), Failure> {
+    let mutation = matches!(method, Method::PluginManagerMutate(_));
+    client
+        .manager_request(
+            Request {
+                id: "cli:plugin-manager".into(),
+                method,
+            },
+            expected_pid,
+            host,
+        )
+        .map(|(reply, pid)| (reply.result, pid))
+        .map_err(|error| match error {
+            ManagerRequestError::BeforeSend(error) => {
+                Failure::failed(format!("selected server request not sent: {error}"))
+            }
+            ManagerRequestError::AfterSend(ApiClientError::ErrorResponse(response))
+                if mutation && response.error.code == "plugin_manager_registry_uncertain" =>
+            {
+                Failure::unknown(format!(
+                    "selected server registry mutation not confirmed: {}",
+                    response.error.message
+                ))
+            }
+            ManagerRequestError::AfterSend(ApiClientError::ErrorResponse(response)) => {
+                Failure::failed(format!(
+                    "server rejected operation ({}): {}",
+                    response.error.code, response.error.message
+                ))
+            }
+            ManagerRequestError::AfterSend(error) if mutation => {
+                Failure::unknown(format!("selected server mutation not confirmed: {error}"))
+            }
+            ManagerRequestError::AfterSend(error) => {
+                Failure::failed(format!("selected server request not confirmed: {error}"))
+            }
+        })
+}
+
+fn own_host() -> Result<PathBuf, Failure> {
+    std::env::current_exe()
+        .and_then(|path| path.canonicalize())
+        .map_err(Failure::failed)
+}
+
+fn context(
+    client: &ApiClient,
+    expected_pid: Option<u32>,
+    host: &Path,
+) -> Result<PluginManagerContextBinding, Failure> {
+    let (reply, peer_pid) = request(
+        client,
+        Method::PluginManagerContext(EmptyParams {}),
+        expected_pid,
+        host,
+    )?;
+    let ResponseResult::PluginManagerContext {
+        protocol,
+        manager_safety_protocol,
+        config_dir,
+        state_dir,
+        pid,
+    } = reply
+    else {
+        return Err(Failure::failed(
+            "server lacks plugin manager context support",
+        ));
+    };
+    if protocol != 2 || manager_safety_protocol != 1 {
+        return Err(Failure::failed(
+            "unsupported server plugin manager safety protocol",
+        ));
+    }
+    if peer_pid != pid {
+        return Err(Failure::failed(
+            "server context PID differs from authenticated peer",
+        ));
+    }
+    // The response contains canonical physical roots. Compare those strings
+    // against the CLI's live physical roots, not against another resolution
+    // of the server's original root after it may have been redirected.
+    if Path::new(&config_dir)
+        != crate::plugin_manager_guard::manager_config_root().map_err(Failure::failed)?
+        || Path::new(&state_dir) != canonical_profile_root(&crate::config::state_dir())?
+    {
+        return Err(Failure::failed(
+            "CLI profile roots differ from selected live server; set the matching XDG_CONFIG_HOME and XDG_STATE_HOME",
+        ));
+    }
+    Ok(PluginManagerContextBinding {
+        pid,
+        config_dir,
+        state_dir,
+    })
+}
+
+fn bound_context(client: &ApiClient, operation: &Operation) -> Result<(), Failure> {
+    let host = own_host()?;
+    let context = context(client, Some(operation.context.pid), &host)?;
+    ensure_binding(
+        operation,
+        Path::new(&context.config_dir),
+        Path::new(&context.state_dir),
+        context.pid,
+        &host,
+    )
+}
+
+fn ensure_binding(
+    operation: &Operation,
+    config: &Path,
+    state: &Path,
+    pid: u32,
+    own_host: &Path,
+) -> Result<(), Failure> {
+    if Path::new(&operation.host) != own_host
+        || pid != operation.context.pid
+        || config != Path::new(&operation.context.config_dir)
+        || state != Path::new(&operation.context.state_dir)
+    {
+        return Err(Failure::failed(
+            "request host or bound server profile/instance differs from selected context",
+        ));
+    }
+    Ok(())
+}
+fn canonical_profile_root(path: &Path) -> Result<PathBuf, Failure> {
+    crate::plugin_manager_guard::resolved(path).map_err(Failure::failed)
+}
+
+fn same_root(a: &Path, b: &Path) -> Result<bool, Failure> {
+    Ok(canonical_profile_root(a)? == canonical_profile_root(b)?)
+}
+
+fn socket_client(socket: &str) -> Result<ApiClient, Failure> {
+    let path = PathBuf::from(socket);
+    if !path.is_absolute() || !path.is_file() && !path.exists() {
+        return Err(Failure::failed(
+            "selected socket must be an existing absolute path",
+        ));
+    }
+    Ok(ApiClient::for_target(ConnectionTarget::SocketPath(path)))
+}
+
+fn list(
+    client: &ApiClient,
+    operation: &Operation,
+) -> Result<Vec<PluginManagerInventoryEntry>, Failure> {
+    let (reply, _) = request(
+        client,
+        Method::PluginManagerInventory(EmptyParams {}),
+        Some(operation.context.pid),
+        Path::new(&operation.host),
+    )?;
+    match reply {
+        ResponseResult::PluginManagerInventory { entries } => {
+            let mut ids = HashSet::new();
+            for entry in &entries {
+                if entry.display.plugin_id != entry.registration.plugin_id
+                    || entry.display.plugin_root != entry.registration.plugin_root
+                    || entry.display.manifest_path != entry.registration.manifest_path
+                    || entry.display.source != entry.registration.source
+                    || entry.display.enabled != entry.registration.enabled
+                    || !ids.insert(&entry.display.plugin_id)
+                {
+                    return Err(Failure::failed("inconsistent manager inventory"));
+                }
+            }
+            Ok(entries)
+        }
+        _ => Err(Failure::failed("unexpected manager inventory response")),
+    }
+}
+
+fn matches_expected(actual: &PluginManagerInventoryEntry, operation: &Operation) -> bool {
+    actual.display == operation.expected && actual.registration == operation.expected_registration
+}
+
+fn selected<'a>(
+    entries: &'a [PluginManagerInventoryEntry],
+    operation: &Operation,
+) -> Result<&'a PluginManagerInventoryEntry, Failure> {
+    let mut matching = entries.iter().filter(|entry| {
+        entry.display.plugin_id == operation.expected.plugin_id
+            || entry.registration.plugin_id == operation.expected.plugin_id
+    });
+    let entry = matching
+        .next()
+        .ok_or_else(|| Failure::failed("plugin is no longer registered"))?;
+    if matching.next().is_some() || !matches_expected(entry, operation) {
+        return Err(Failure::failed(
+            "plugin registration changed since confirmation",
+        ));
+    }
+    Ok(entry)
+}
+
+fn check_protection(
+    expected: &InstalledPluginInfo,
+    registration: &InstalledPluginInfo,
+    entries: &[PluginManagerInventoryEntry],
+    roots: &[String],
+    extra: &[&Path],
+) -> Result<(), Failure> {
+    let mut paths = Vec::with_capacity(6 + extra.len());
+    for info in [expected, registration] {
+        paths.push(Path::new(&info.plugin_root));
+        paths.push(Path::new(&info.manifest_path));
+        if let Some(path) = info.source.managed_path.as_deref() {
+            paths.push(Path::new(path));
+        }
+    }
+    paths.extend_from_slice(extra);
+    let protected: Vec<_> = entries
+        .iter()
+        .flat_map(|entry| [&entry.display, &entry.registration])
+        .filter(|info| crate::plugin_manager_guard::protected(info))
+        .cloned()
+        .collect();
+    ensure_safe(&expected.plugin_id, &paths, &protected, roots).map_err(Failure::failed)
+}
+
+/// Carry both forms of every registered Pet root through admission-lock
+/// creation; an old cached path can differ from its refreshed display path.
+fn protection_roots(operation: &Operation, entries: &[PluginManagerInventoryEntry]) -> Vec<String> {
+    let mut roots = operation.protected_roots.clone();
+    for info in entries
+        .iter()
+        .flat_map(|entry| [&entry.display, &entry.registration])
+        .filter(|info| crate::plugin_manager_guard::protected(info))
+    {
+        roots.push(info.plugin_root.clone());
+        roots.push(info.manifest_path.clone());
+        if let Some(path) = &info.source.managed_path {
+            roots.push(path.clone());
+        }
+    }
+    roots
+}
+
+fn mutate(
+    client: &ApiClient,
+    operation: &Operation,
+    lease_token: &str,
+    replacement: Option<PluginManagerReplacement>,
+) -> Result<(), Failure> {
+    let (result, _) = request(
+        client,
+        Method::PluginManagerMutate(PluginManagerMutationParams {
+            action: operation.action,
+            original_context: operation.context.clone(),
+            expected_registration: operation.expected_registration.clone(),
+            expected: operation.expected.clone(),
+            protected_roots: operation.protected_roots.clone(),
+            lease_token: lease_token.to_owned(),
+            replacement,
+        }),
+        Some(operation.context.pid),
+        Path::new(&operation.host),
+    )?;
+    match result {
+        ResponseResult::PluginManagerMutation { plugin_id, action }
+            if plugin_id == operation.expected.plugin_id && action == operation.action =>
+        {
+            Ok(())
+        }
+        _ => Err(Failure::unknown(
+            "server returned an unexpected mutation result",
+        )),
+    }
+}
+
+fn update(
+    client: &ApiClient,
+    operation: &Operation,
+    registrations: &[PluginManagerInventoryEntry],
+    lease_token: &str,
+) -> Result<String, Failure> {
+    let old = &operation.expected;
+    if old.source.kind != PluginSourceKind::Github {
+        return Err(Failure::failed(
+            "update is supported only for recorded GitHub installs",
+        ));
+    }
+    let source = GithubPluginSource {
+        owner: old
+            .source
+            .owner
+            .clone()
+            .ok_or_else(|| Failure::failed("missing GitHub owner"))?,
+        repo: old
+            .source
+            .repo
+            .clone()
+            .ok_or_else(|| Failure::failed("missing GitHub repository"))?,
+        subdir: old.source.subdir.clone(),
+    };
+    // Enforce the ordinary installer's source grammar, including path traversal.
+    let source_name = format!(
+        "{}/{}{}",
+        source.owner,
+        source.repo,
+        source
+            .subdir
+            .as_ref()
+            .map(|path| format!("/{path}"))
+            .unwrap_or_default()
+    );
+    if GithubPluginSource::parse(&source_name).map_err(Failure::failed)? != source {
+        return Err(Failure::failed("invalid recorded GitHub source"));
+    }
+    let reference = old.source.requested_ref.as_deref();
+    let plugins_parent =
+        crate::plugin_manager_guard::manager_managed_plugins_dir().map_err(Failure::failed)?;
+    let final_checkout =
+        crate::plugin_paths::managed_checkout_path_in(&plugins_parent, &old.plugin_id);
+    let stored = old
+        .source
+        .managed_path
+        .as_deref()
+        .ok_or_else(|| Failure::failed("missing managed checkout"))?;
+    if !same_managed_checkout(Path::new(stored), &final_checkout) {
+        return Err(Failure::failed(
+            "recorded checkout does not match the managed installation",
+        ));
+    }
+    check_protection(
+        old,
+        &operation.expected_registration,
+        registrations,
+        &operation.protected_roots,
+        &[&final_checkout],
+    )?;
+    let temp_root =
+        create_plugin_temp_dir("manager-update", &plugins_parent).map_err(Failure::failed)?;
+    let mut retain_temp = false;
+    let result = (|| {
+        let checkout = temp_root.join("checkout");
+        git_checkout(&source, reference, &checkout).map_err(Failure::failed)?;
+        let commit = git_output(&checkout, ["rev-parse", "HEAD"]).map_err(Failure::failed)?;
+        let manifest_root = source.manifest_root(&checkout);
+        let preview =
+            load_cli_plugin_manifest(&manifest_root, old.enabled).map_err(Failure::failed)?;
+        let expected_root =
+            managed_manifest_root(&checkout, source.subdir.as_deref()).map_err(Failure::failed)?;
+        ensure_installed_manifest_matches_checkout(&preview, &expected_root)
+            .map_err(Failure::failed)?;
+        if preview.plugin_id != old.plugin_id {
+            return Err(Failure::failed(
+                "candidate manifest changes plugin ID; refusing build",
+            ));
+        }
+        check_protection(
+            &preview,
+            &operation.expected_registration,
+            registrations,
+            &operation.protected_roots,
+            &[&final_checkout],
+        )?;
+        run_plugin_build_commands(&preview, &manifest_root).map_err(Failure::failed)?;
+        let built =
+            load_cli_plugin_manifest(&manifest_root, old.enabled).map_err(Failure::failed)?;
+        let expected_root =
+            managed_manifest_root(&checkout, source.subdir.as_deref()).map_err(Failure::failed)?;
+        ensure_installed_manifest_matches_checkout(&built, &expected_root)
+            .map_err(Failure::failed)?;
+        ensure_manifest_unchanged_after_build(&preview, &built).map_err(Failure::failed)?;
+        check_protection(
+            &built,
+            &operation.expected_registration,
+            registrations,
+            &operation.protected_roots,
+            &[&final_checkout],
+        )?;
+        bound_context(client, operation)?;
+        let latest = list(client, operation)?;
+        selected(&latest, operation).map_err(|_| {
+            Failure::failed("server or registration changed before checkout replacement")
+        })?;
+        check_protection(
+            old,
+            &operation.expected_registration,
+            &latest,
+            &operation.protected_roots,
+            &[&final_checkout],
+        )?;
+        check_protection(
+            &built,
+            &operation.expected_registration,
+            &latest,
+            &operation.protected_roots,
+            &[&final_checkout],
+        )?;
+        let backup = temp_root
+            .canonicalize()
+            .map_err(Failure::failed)?
+            .join("previous-checkout");
+        // Network/context/inventory work can outlive the built snapshot. Reload
+        // at the last pre-swap boundary rather than trusting its old coordinates.
+        let fresh =
+            load_cli_plugin_manifest(&manifest_root, old.enabled).map_err(Failure::failed)?;
+        let expected_root =
+            managed_manifest_root(&checkout, source.subdir.as_deref()).map_err(Failure::failed)?;
+        ensure_installed_manifest_matches_checkout(&fresh, &expected_root)
+            .map_err(Failure::failed)?;
+        ensure_manifest_unchanged_after_build(&built, &fresh).map_err(Failure::failed)?;
+        check_protection(
+            &fresh,
+            &operation.expected_registration,
+            &latest,
+            &operation.protected_roots,
+            &[&final_checkout],
+        )?;
+        fs::rename(&final_checkout, &backup).map_err(Failure::failed)?;
+        if let Err(err) = fs::rename(&checkout, &final_checkout) {
+            let latest = list(client, operation).map_err(|inventory_err| { retain_temp = true; Failure::partial(format!("checkout install failed: {err}; restore inventory unavailable: {}; old checkout retained at {}", inventory_err.detail, backup.display())) })?;
+            if let Err(protection) = check_protection(
+                old,
+                &operation.expected_registration,
+                &latest,
+                &operation.protected_roots,
+                &[&final_checkout, &backup],
+            ) {
+                retain_temp = true;
+                return Err(Failure::partial(format!(
+                    "checkout install failed: {err}; restore blocked by protection check: {}; old checkout retained at {}",
+                    protection.detail,
+                    backup.display()
+                )));
+            }
+            if let Err(restore) = fs::rename(&backup, &final_checkout) {
+                retain_temp = true;
+                return Err(Failure::partial(format!(
+                    "checkout install failed: {err}; previous checkout retained at {} because restore failed: {restore}",
+                    backup.display()
+                )));
+            }
+            return Err(Failure::failed(format!(
+                "checkout install failed; old checkout restored: {err}"
+            )));
+        }
+        let source_info = source.to_source_info(
+            old.source.requested_ref.clone(),
+            commit,
+            Some(stored.to_owned()),
+            current_unix_ms(),
+        );
+        let replacement = PluginManagerReplacement {
+            path: source.manifest_root(&final_checkout).display().to_string(),
+            source: source_info,
+            previous_checkout: backup.display().to_string(),
+        };
+        #[cfg(test)]
+        MANAGER_FINAL_LAYOUT_TEST.with(|callback| {
+            if let Some(callback) = callback.borrow_mut().take() {
+                callback(&final_checkout);
+            }
+        });
+        // Every final-local failure is definite and must enter the same rollback
+        // branch as a rejected mutation. An outer `?` here would delete the backup.
+        let registration = (|| {
+            let final_plugin =
+                load_cli_plugin_manifest(&source.manifest_root(&final_checkout), old.enabled)
+                    .map_err(Failure::failed)?;
+            let expected_root = managed_manifest_root(&final_checkout, source.subdir.as_deref())
+                .map_err(Failure::failed)?;
+            ensure_installed_manifest_matches_checkout(&final_plugin, &expected_root)
+                .map_err(Failure::failed)?;
+            mutate(client, operation, lease_token, Some(replacement))
+        })();
+        match registration {
+            Ok(()) => {}
+            Err(failure) if failure.status == "unknown" => {
+                retain_temp = true;
+                return Err(Failure::unknown(format!(
+                    "registration outcome uncertain; new checkout at {}, previous checkout retained at {}: {}",
+                    final_checkout.display(),
+                    backup.display(),
+                    failure.detail
+                )));
+            }
+            Err(failure) => {
+                let latest = list(client, operation).map_err(|err| { retain_temp = true; Failure::partial(format!("registration rejected: {}; rollback inventory unavailable: {}; old checkout retained at {}", failure.detail, err.detail, backup.display())) })?;
+                if let Err(protection) = check_protection(
+                    old,
+                    &operation.expected_registration,
+                    &latest,
+                    &operation.protected_roots,
+                    &[&final_checkout, &backup],
+                ) {
+                    retain_temp = true;
+                    return Err(Failure::partial(format!(
+                        "registration rejected: {}; rollback blocked by protection check: {}; previous checkout retained at {}",
+                        failure.detail,
+                        protection.detail,
+                        backup.display()
+                    )));
+                }
+                let removed = fs::remove_dir_all(&final_checkout);
+                let restored = if removed.is_ok() {
+                    fs::rename(&backup, &final_checkout)
+                } else {
+                    Err(io::Error::other("new checkout could not be removed"))
+                };
+                if let Err(err) = restored {
+                    retain_temp = true;
+                    return Err(Failure::partial(format!(
+                        "registration rejected: {}; old checkout retained at {}: {err}",
+                        failure.detail,
+                        backup.display()
+                    )));
+                }
+                return Err(failure);
+            }
+        }
+        let latest = list(client, operation).map_err(|err| { retain_temp = true; Failure::partial(format!("updated registration; cleanup inventory unavailable: {}; old checkout retained at {}", err.detail, backup.display())) })?;
+        if let Err(protection) = check_protection(
+            old,
+            &operation.expected_registration,
+            &latest,
+            &operation.protected_roots,
+            &[&final_checkout, &backup],
+        ) {
+            retain_temp = true;
+            return Err(Failure::partial(format!(
+                "updated registration; old checkout retained at {} because cleanup protection check failed: {}",
+                backup.display(),
+                protection.detail
+            )));
+        }
+        fs::remove_dir_all(&backup).map_err(|err| {
+            retain_temp = true;
+            Failure::partial(format!(
+                "updated registration; old checkout retained at {}: {err}",
+                backup.display()
+            ))
+        })?;
+        Ok(format!(
+            "Updated {} from recorded GitHub source; enabled={} preserved; config and state retained",
+            old.plugin_id, old.enabled
+        ))
+    })();
+    if !retain_temp {
+        if let Err(err) = fs::remove_dir_all(&temp_root) {
+            if result.is_ok() {
+                return Err(Failure::partial(format!(
+                    "update completed but temporary checkout cleanup failed at {}: {err}",
+                    temp_root.display()
+                )));
+            }
+        }
+    }
+    result
+}
+
+fn check_uninstall_checkout(plugin: &InstalledPluginInfo) -> Result<(), Failure> {
+    if plugin.source.kind != PluginSourceKind::Github {
+        return Err(Failure::failed(
+            "uninstall requires a managed GitHub plugin",
+        ));
+    }
+    let stored = plugin
+        .source
+        .managed_path
+        .as_deref()
+        .ok_or_else(|| Failure::failed("missing managed checkout path"))?;
+    let plugins_parent =
+        crate::plugin_manager_guard::manager_managed_plugins_dir().map_err(Failure::failed)?;
+    let expected =
+        crate::plugin_paths::managed_checkout_path_in(&plugins_parent, &plugin.plugin_id);
+    let stored_path = Path::new(stored);
+    // A manually removed checkout needs no deletion. A different path or a
+    // symlink leaf must be rejected before unlinking the registration.
+    let stored_missing =
+        fs::symlink_metadata(stored_path).is_err_and(|err| err.kind() == io::ErrorKind::NotFound);
+    let expected_missing =
+        fs::symlink_metadata(&expected).is_err_and(|err| err.kind() == io::ErrorKind::NotFound);
+    if stored_missing && expected_missing && same_root(stored_path, &expected)? {
+        return Ok(());
+    }
+    if !same_managed_checkout(stored_path, &expected) {
+        return Err(Failure::failed(
+            "recorded checkout does not match the managed installation",
+        ));
+    }
+    Ok(())
+}
+
+fn apply(operation: &Operation) -> Result<String, Failure> {
+    if operation.protocol != 2
+        || operation.operation_id.is_empty()
+        || operation.operation_id.len() > 128
+        || !operation
+            .operation_id
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || byte == b'-' || byte == b'_')
+    {
+        return Err(Failure::failed(
+            "invalid plugin manager protocol or operation ID",
+        ));
+    }
+    let client = socket_client(&operation.socket)?;
+    bound_context(&client, operation)?;
+    // All prospective registry and admission-lock write surfaces must pass
+    // protection before lock_operations creates its first file.
+    let plugins_parent =
+        crate::plugin_manager_guard::manager_managed_plugins_dir().map_err(Failure::failed)?;
+    let lock_path = plugins_parent.join(".manager.lock");
+    let install_lock_path = plugins_parent.join(".plugin-install.lock");
+    let registry_writes =
+        crate::persist::plugin_registry::manager_write_paths().map_err(Failure::failed)?;
+    let mut write_paths: Vec<&Path> = vec![&lock_path, &install_lock_path];
+    write_paths.extend(registry_writes.iter().map(PathBuf::as_path));
+    let before_lock = list(&client, operation)?;
+    let before = selected(&before_lock, operation)?;
+    check_protection(
+        &before.display,
+        &before.registration,
+        &before_lock,
+        &operation.protected_roots,
+        &write_paths,
+    )?;
+    let (_locks, lease_token) = lock_operations(&protection_roots(operation, &before_lock))?;
+    // Repeat original host, profile and server instance validation *inside*
+    // the long-lived manager transaction lock.
+    bound_context(&client, operation)?;
+    let entries = list(&client, operation)?;
+    let current = selected(&entries, operation)?;
+    check_protection(
+        &current.display,
+        &current.registration,
+        &entries,
+        &operation.protected_roots,
+        &write_paths,
+    )?;
+    match operation.action {
+        PluginManagerAction::Update | PluginManagerAction::Uninstall
+            if current.display.source.kind != PluginSourceKind::Github =>
+        {
+            return Err(Failure::failed(
+                "operation requires a managed GitHub plugin",
+            ));
+        }
+        PluginManagerAction::Unlink if current.display.source.kind != PluginSourceKind::Local => {
+            return Err(Failure::failed(
+                "operation requires a locally linked plugin",
+            ));
+        }
+        _ => {}
+    }
+    if operation.action == PluginManagerAction::Update {
+        return update(&client, operation, &entries, &lease_token);
+    }
+    if operation.action == PluginManagerAction::Uninstall {
+        check_uninstall_checkout(&current.display)?;
+    }
+    mutate(&client, operation, &lease_token, None)?;
+    match operation.action {
+        PluginManagerAction::Uninstall => {
+            let latest = list(&client, operation).map_err(|err| Failure::partial(err.detail))?;
+            check_protection(
+                &current.display,
+                &current.registration,
+                &latest,
+                &operation.protected_roots,
+                &[Path::new(&current.display.plugin_root)],
+            )
+            .map_err(|err| {
+                Failure::partial(format!(
+                    "Unlinked {}; checkout retained: {}",
+                    current.display.plugin_id, err.detail
+                ))
+            })?;
+            check_uninstall_checkout(&current.display).map_err(|err| {
+                Failure::partial(format!(
+                    "Unlinked {}; checkout retained: {}",
+                    current.display.plugin_id, err.detail
+                ))
+            })?;
+            remove_managed_plugin_files(&current.display).map_err(|err| Failure::partial(format!(
+                "Unlinked {}; failed to remove managed checkout: {err}; config and state retained", current.display.plugin_id)))?;
+            Ok(format!(
+                "Uninstalled {}; retained plugin config and state; local checkout (if any) untouched",
+                current.display.plugin_id
+            ))
+        }
+        PluginManagerAction::Unlink => Ok(format!(
+            "Unlinked {}; files, config and state retained",
+            current.display.plugin_id
+        )),
+        PluginManagerAction::Enable => Ok(format!("Enabled {}", current.display.plugin_id)),
+        PluginManagerAction::Disable => Ok(format!("Disabled {}", current.display.plugin_id)),
+        PluginManagerAction::Update => unreachable!(),
+    }
+}
+
+#[cfg(not(unix))]
+fn lock_operations(_: &[String]) -> Result<((File, File), String), Failure> {
+    Err(Failure::failed(
+        "plugin manager mutations require a Unix host",
+    ))
+}
+
+#[cfg(unix)]
+fn lock_operations(roots: &[String]) -> Result<((File, File), String), Failure> {
+    let install =
+        crate::plugin_manager_guard::lock_install_roots_guarded(roots).map_err(Failure::failed)?;
+    let mut manager =
+        crate::plugin_manager_guard::lock_manager_lease_guarded(roots).map_err(Failure::failed)?;
+    let mut random = [0u8; 16];
+    File::open("/dev/urandom")
+        .and_then(|mut source| source.read_exact(&mut random))
+        .map_err(Failure::failed)?;
+    let mut token = String::with_capacity(32);
+    for byte in random {
+        write!(&mut token, "{byte:02x}").map_err(Failure::failed)?;
+    }
+    crate::plugin_manager_guard::verify_manager_lease_lock_binding(&manager, roots)
+        .map_err(Failure::failed)?;
+    manager.set_len(0).map_err(Failure::failed)?;
+    writeln!(manager, "{} {token}", std::process::id()).map_err(Failure::failed)?;
+    manager.sync_data().map_err(Failure::failed)?;
+    Ok(((install, manager), token))
+}
+
+const RESULT_LIMIT: usize = 128 * 1024;
+
+#[cfg(unix)]
+/// Own the inherited admission lease and reserve a private result inode
+/// before the first mutation. All journal names resolve below an open dir FD.
+struct Journal {
+    dir: File,
+    staging: File,
+    _admission: File,
+}
+
+#[cfg(unix)]
+fn open_sibling(dir: &File, name: &str, flags: i32, mode: libc::mode_t) -> io::Result<File> {
+    let name = CString::new(name).map_err(io::Error::other)?;
+    let fd = unsafe {
+        libc::openat(
+            dir.as_raw_fd(),
+            name.as_ptr(),
+            flags | libc::O_CLOEXEC | libc::O_NOFOLLOW,
+            mode as libc::c_uint,
+        )
+    };
+    if fd < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(unsafe { File::from_raw_fd(fd) })
+}
+
+#[cfg(unix)]
+fn private_regular(file: &File, label: &str) -> io::Result<std::fs::Metadata> {
+    use std::os::unix::fs::MetadataExt;
+    let meta = file.metadata()?;
+    if !meta.is_file()
+        || meta.uid() != unsafe { libc::geteuid() }
+        || meta.nlink() != 1
+        || meta.mode() & 0o777 != 0o600
+    {
+        return Err(io::Error::other(format!(
+            "{label} is not a private owned single-link regular file"
+        )));
+    }
+    Ok(meta)
+}
+
+#[cfg(unix)]
+fn same_inode(a: &File, b: &File) -> io::Result<bool> {
+    use std::os::unix::fs::MetadataExt;
+    let a = a.metadata()?;
+    let b = b.metadata()?;
+    Ok(a.dev() == b.dev() && a.ino() == b.ino())
+}
+
+#[cfg(unix)]
+impl Journal {
+    fn open(path: &Path, admission_fd: RawFd) -> io::Result<(Self, Operation)> {
+        use std::os::unix::fs::MetadataExt;
+        if admission_fd < 3
+            || !path.is_absolute()
+            || path.file_name() != Some(std::ffi::OsStr::new("request.json"))
+        {
+            return Err(io::Error::other(
+                "request must be an absolute operation/request.json and admission FD >= 3",
+            ));
+        }
+        // Close-on-exec before any child invocation; never unlock the shared
+        // open-file description inherited from the parent.
+        let flags = unsafe { libc::fcntl(admission_fd, libc::F_GETFD) };
+        if flags < 0
+            || unsafe { libc::fcntl(admission_fd, libc::F_SETFD, flags | libc::FD_CLOEXEC) } < 0
+        {
+            return Err(io::Error::last_os_error());
+        }
+        let admission = unsafe { File::from_raw_fd(admission_fd) };
+        private_regular(&admission, "inherited operation lock")?;
+        let parent = path
+            .parent()
+            .ok_or_else(|| io::Error::other("request has no parent"))?;
+        let directory =
+            CString::new(parent.as_os_str().as_encoded_bytes()).map_err(io::Error::other)?;
+        let dir_fd = unsafe {
+            libc::open(
+                directory.as_ptr(),
+                libc::O_RDONLY | libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_CLOEXEC,
+            )
+        };
+        if dir_fd < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        let dir = unsafe { File::from_raw_fd(dir_fd) };
+        let meta = dir.metadata()?;
+        if !meta.is_dir()
+            || meta.uid() != unsafe { libc::geteuid() }
+            || meta.mode() & 0o777 != 0o700
+        {
+            return Err(io::Error::other(
+                "operation directory must be private and owned",
+            ));
+        }
+        let sibling = open_sibling(&dir, "operation.lock", libc::O_RDWR, 0)?;
+        private_regular(&sibling, "operation lock sibling")?;
+        if !same_inode(&admission, &sibling)? {
+            return Err(io::Error::other(
+                "inherited admission FD does not match operation.lock",
+            ));
+        }
+        if unsafe { libc::flock(sibling.as_raw_fd(), libc::LOCK_EX | libc::LOCK_NB) } == 0 {
+            return Err(io::Error::other("inherited operation lock was not held"));
+        }
+        if io::Error::last_os_error().kind() != io::ErrorKind::WouldBlock {
+            return Err(io::Error::last_os_error());
+        }
+        // Check the inherited description itself, not just that some other
+        // process holds a lock on the same inode.
+        if unsafe { libc::flock(admission.as_raw_fd(), libc::LOCK_EX | libc::LOCK_NB) } != 0 {
+            return Err(io::Error::other(
+                "inherited descriptor does not own the exclusive lease",
+            ));
+        }
+        let mut request = open_sibling(&dir, "request.json", libc::O_RDONLY, 0)?;
+        let request_meta = private_regular(&request, "request")?;
+        if request_meta.len() > 1024 * 1024 {
+            return Err(io::Error::other("request exceeded 1 MiB"));
+        }
+        let mut bytes = Vec::with_capacity(request_meta.len() as usize);
+        (&mut request)
+            .take(1024 * 1024 + 1)
+            .read_to_end(&mut bytes)?;
+        if bytes.len() > 1024 * 1024
+            || !same_inode(
+                &request,
+                &open_sibling(&dir, "request.json", libc::O_RDONLY, 0)?,
+            )?
+        {
+            return Err(io::Error::other("request changed or exceeded 1 MiB"));
+        }
+        let operation: Operation = serde_json::from_slice(&bytes).map_err(io::Error::other)?;
+        if operation.protocol != 2
+            || operation.operation_id.is_empty()
+            || operation.operation_id.len() > 128
+            || !operation
+                .operation_id
+                .bytes()
+                .all(|byte| byte.is_ascii_alphanumeric() || byte == b'-' || byte == b'_')
+            || operation.expected.plugin_id.len() > 256
+            || parent.file_name() != Some(std::ffi::OsStr::new(&operation.operation_id))
+        {
+            return Err(io::Error::other(
+                "request protocol, identifier or operation directory mismatch",
+            ));
+        }
+        match open_sibling(&dir, "result.json", libc::O_RDONLY, 0) {
+            Ok(_) => return Err(io::Error::other("result already exists")),
+            Err(err) if err.kind() == io::ErrorKind::NotFound => {}
+            Err(err) => return Err(err),
+        }
+        let mut staging = open_sibling(
+            &dir,
+            "result.staging",
+            libc::O_CREAT | libc::O_EXCL | libc::O_WRONLY,
+            0o600,
+        )?;
+        private_regular(&staging, "reserved result staging")?;
+        // Reserve the maximum result budget before touching any plugin.
+        // This also tests real writes rather than relying on sparse set_len.
+        for _ in 0..(RESULT_LIMIT / 8192) {
+            staging.write_all(&[0; 8192])?;
+        }
+        staging.sync_all()?;
+        dir.sync_all()?;
+        Ok((
+            Self {
+                dir,
+                staging,
+                _admission: admission,
+            },
+            operation,
+        ))
+    }
+
+    fn publish(mut self, operation: &Operation, result: Result<String, Failure>) -> io::Result<()> {
+        let (status, mut detail) = match result {
+            Ok(detail) => ("completed", detail),
+            Err(err) => (err.status, err.detail),
+        };
+        let action = format!("{:?}", operation.action).to_lowercase();
+        let mut record;
+        loop {
+            record = serde_json::to_vec(&json!({
+                "protocol": 2, "operation_id": operation.operation_id,
+                "action": action, "plugin_id": operation.expected.plugin_id,
+                "status": status, "detail": detail
+            }))
+            .map_err(io::Error::other)?;
+            if record.len() <= RESULT_LIMIT {
+                break;
+            }
+            let mut cut = detail
+                .len()
+                .saturating_sub(record.len() - RESULT_LIMIT + 64);
+            while !detail.is_char_boundary(cut) {
+                cut -= 1;
+            }
+            detail.truncate(cut);
+            detail.push_str(" [diagnostic truncated to fit durable result]");
+        }
+        self.staging.rewind()?;
+        self.staging.write_all(&record)?;
+        self.staging.set_len(record.len() as u64)?;
+        self.staging.sync_all()?;
+        if unsafe {
+            libc::renameat(
+                self.dir.as_raw_fd(),
+                c"result.staging".as_ptr(),
+                self.dir.as_raw_fd(),
+                c"result.json".as_ptr(),
+            )
+        } != 0
+        {
+            return Err(io::Error::last_os_error());
+        }
+        if let Err(err) = self.dir.sync_all() {
+            // A visible but not durably renamed success is not terminal proof.
+            // Keep the inherited lease until the best-effort removal finishes.
+            unsafe { libc::unlinkat(self.dir.as_raw_fd(), c"result.json".as_ptr(), 0) };
+            let _ = self.dir.sync_all();
+            return Err(err);
+        }
+        Ok(())
+    }
+}
+
+pub(super) fn run(args: &[String]) -> io::Result<i32> {
+    match args {
+        [command, json] if command == "capabilities" && json == "--json" => {
+            println!(
+                "{}",
+                json!({"product_id":"herdr-plugin-manager-host","protocol":2,"manager_safety_protocol":1,"durable_result_protocol":1,"admission_fd_protocol":1,"actions":["enable","disable","unlink","uninstall","update"]})
+            );
+            Ok(0)
+        }
+        [command, socket_flag, socket, json_flag]
+            if command == "context" && socket_flag == "--socket" && json_flag == "--json" =>
+        {
+            let outcome = (|| -> Result<Value, Failure> {
+                let client = socket_client(socket)?;
+                let host = own_host()?;
+                let context = context(&client, None, &host)?;
+                Ok(
+                    json!({"protocol":2,"manager_safety_protocol":1,"socket":socket,"host":host,
+                    "config_dir":context.config_dir,"state_dir":context.state_dir,"pid":context.pid}),
+                )
+            })();
+            match outcome {
+                Ok(value) => {
+                    println!("{value}");
+                    Ok(0)
+                }
+                Err(err) => {
+                    eprintln!("{}", err.detail);
+                    Ok(1)
+                }
+            }
+        }
+        [command, request_flag, path, admission_flag, fd]
+            if command == "apply"
+                && request_flag == "--request"
+                && admission_flag == "--admission-fd" =>
+        {
+            #[cfg(unix)]
+            {
+                let admission_fd: RawFd = fd
+                    .parse()
+                    .map_err(|_| io::Error::other("invalid admission FD"))?;
+                let (journal, operation) = Journal::open(Path::new(path), admission_fd)?;
+                // The durable record, not stdout or exit status, proves outcome.
+                // Publication failure after mutation is explicitly unknown.
+                journal.publish(&operation, apply(&operation))?;
+                Ok(0)
+            }
+            #[cfg(not(unix))]
+            {
+                let _ = (path, fd);
+                Err(io::Error::other(
+                    "plugin manager apply requires a Unix host",
+                ))
+            }
+        }
+        _ => {
+            eprintln!(
+                "usage: herdr plugin manager capabilities --json | context --socket ABS --json | apply --request ABS_JSON --admission-fd N"
+            );
+            Ok(2)
+        }
+    }
+}
