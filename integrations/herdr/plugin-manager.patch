+        assert_eq!(result["result"]["type"], "plugin_manager_mutation");
+        assert!(
+            crate::persist::plugin_registry::manager_inventory().unwrap()[0]
+                .registration
+                .enabled
+        );
+
+        let confirmed = crate::persist::plugin_registry::manager_inventory()
+            .unwrap()
+            .remove(0);
+        let before = std::fs::read(&registry).unwrap();
+        let memory = app.state.installed_plugins.clone();
+        app.state.agent_view_override = Some(view("plugin:example.manager"));
+        for (stage, code) in [
+            (
+                crate::persist::plugin_registry::ManagerSyncStage::Temporary,
+                "plugin_manager_registry_failed",
+            ),
+            (
+                crate::persist::plugin_registry::ManagerSyncStage::Destination,
+                "plugin_manager_registry_uncertain",
+            ),
+        ] {
+            let fault = crate::persist::plugin_registry::manager_sync_test(Some((stage, None)));
+            let response = app.handle_plugin_manager_mutate(
+                "unconfirmed-unlink".into(),
+                params(
+                    PluginManagerAction::Unlink,
+                    confirmed.display.clone(),
+                    confirmed.registration.clone(),
+                ),
+            );
+            let result: serde_json::Value = serde_json::from_str(&response).unwrap();
+            assert_eq!(result["error"]["code"], code);
+            assert_eq!(app.state.installed_plugins, memory);
+            assert_eq!(
+                app.state.agent_view_override.as_ref().unwrap().source,
+                "plugin:example.manager"
+            );
+            assert!(app.state.plugin_panes.contains_key(&owned));
+            assert!(app.state.plugin_panes.contains_key(&other));
+            if stage == crate::persist::plugin_registry::ManagerSyncStage::Temporary {
+                assert_eq!(std::fs::read(&registry).unwrap(), before);
+            } else {
+                assert!(crate::persist::plugin_registry::manager_inventory()
+                    .unwrap()
+                    .is_empty());
+            }
+            drop(fault);
+            std::fs::write(&registry, &before).unwrap();
+        }
+        let fresh = crate::persist::plugin_registry::manager_inventory()
+            .unwrap()
+            .remove(0);
+        app.state.agent_view_override = Some(view("plugin:example.other"));
+        let response = app.handle_plugin_manager_mutate(
+            "unlink".into(),
+            params(
+                PluginManagerAction::Unlink,
+                fresh.display,
+                fresh.registration,
+            ),
+        );
+        let result: serde_json::Value = serde_json::from_str(&response).unwrap();
+        assert_eq!(result["result"]["type"], "plugin_manager_mutation");
+        assert_eq!(
+            app.state.agent_view_override.as_ref().unwrap().source,
+            "plugin:example.other"
+        );
+        assert!(!app.state.plugin_panes.contains_key(&owned));
+        assert!(app.state.plugin_panes.contains_key(&other));
+
+        let prior = load_plugin_manifest(&manifest_root.display().to_string(), true).unwrap();
+        crate::persist::plugin_registry::save_to_path(&registry, &[prior]).unwrap();
+        let stale = crate::persist::plugin_registry::manager_inventory()
+            .unwrap()
+            .remove(0);
+        app.state.agent_view_override = Some(view("plugin:example.manager"));
+        app.state.plugin_panes.insert(
+            owned,
+            crate::app::state::PluginPaneRecord {
+                plugin_id: "example.manager".into(),
+                entrypoint: "panel".into(),
+            },
+        );
+        write_manifest(&manifest_root, "Changed After Confirmation", "3.0.0");
+        let before = std::fs::read(&registry).unwrap();
+        let response = app.handle_plugin_manager_mutate(
+            "stale".into(),
+            params(
+                PluginManagerAction::Disable,
+                stale.display,
+                stale.registration,
+            ),
+        );
+        let result: serde_json::Value = serde_json::from_str(&response).unwrap();
+        assert_eq!(result["error"]["code"], "plugin_manager_rejected");
+        assert_eq!(std::fs::read(&registry).unwrap(), before);
+        assert_eq!(
+            app.state.agent_view_override.as_ref().unwrap().source,
+            "plugin:example.manager"
+        );
+        assert!(app.state.plugin_panes.contains_key(&owned));
+        let mut managed = load_plugin_manifest(&manifest_root.display().to_string(), true).unwrap();
+        managed.source.kind = PluginSourceKind::Github;
+        managed.source.managed_path = Some(manifest_root.display().to_string());
+        managed.source.owner = Some("owner".into());
+        managed.source.repo = Some("repo".into());
+        crate::persist::plugin_registry::save_to_path(&registry, &[managed]).unwrap();
+        let selected = crate::persist::plugin_registry::manager_inventory()
+            .unwrap()
+            .remove(0);
+        let response = app.handle_plugin_manager_mutate(
+            "uninstall".into(),
+            params(
+                PluginManagerAction::Uninstall,
+                selected.display,
+                selected.registration,
+            ),
+        );
+        let result: serde_json::Value = serde_json::from_str(&response).unwrap();
+        assert_eq!(result["result"]["type"], "plugin_manager_mutation");
+        assert!(app.state.agent_view_override.is_none());
+        assert!(!app.state.plugin_panes.contains_key(&owned));
+        assert!(app.state.plugin_panes.contains_key(&other));
+        assert!(crate::persist::plugin_registry::manager_inventory()
+            .unwrap()
+            .is_empty());
+
+        // Exercise the real Update adapter with the installer's full subdir
+        // grammar, stale cached metadata, disabled state and user-owned bytes.
+        let checkout = crate::plugin_paths::managed_checkout_path_in(&lease_dir, "example.manager");
+        let scoped_root = checkout.join("@scope/space plugin");
+        write_manifest(&scoped_root, "Cached Managed", "1.0.0");
+        let mut raw = load_plugin_manifest(&scoped_root.display().to_string(), false).unwrap();
+        raw.source = crate::api::schema::PluginSourceInfo {
+            kind: PluginSourceKind::Github,
+            owner: Some("owner".into()),
+            repo: Some("repo".into()),
+            subdir: Some("@scope/space plugin".into()),
+            requested_ref: Some("release".into()),
+            resolved_commit: Some("old-commit".into()),
+            managed_path: Some(checkout.canonicalize().unwrap().display().to_string()),
+            installed_unix_ms: Some(42),
+        };
+        crate::persist::plugin_registry::save_to_path(&registry, &[raw]).unwrap();
+        write_manifest(&scoped_root, "Confirmed Old", "2.0.0");
+        let selected = crate::persist::plugin_registry::manager_inventory()
+            .unwrap()
+            .remove(0);
+        let backup = root.join("previous-scoped-checkout");
+        std::fs::write(checkout.join("user-bytes"), b"keep old checkout bytes").unwrap();
+        let user_config = crate::plugin_paths::plugin_config_dir("example.manager");
+        let user_state = crate::plugin_paths::plugin_state_dir("example.manager");
+        std::fs::create_dir_all(&user_config).unwrap();
+        std::fs::create_dir_all(&user_state).unwrap();
+        std::fs::write(user_config.join("keep"), b"config bytes").unwrap();
+        std::fs::write(user_state.join("keep"), b"state bytes").unwrap();
+        std::fs::rename(&checkout, &backup).unwrap();
+        write_manifest(&scoped_root, "New Scoped", "3.0.0");
+        let mut source = selected.registration.source.clone();
+        source.resolved_commit = Some("new-commit".into());
+        let mut update = params(
+            PluginManagerAction::Update,
+            selected.display,
+            selected.registration,
+        );
+        update.replacement = Some(PluginManagerReplacement {
+            path: scoped_root.display().to_string(),
+            previous_checkout: backup.display().to_string(),
+            source,
+        });
+        // Direct guarded calls cannot bypass the installer's exact layout, and
+        // a prechecked candidate must be freshly rejected under the registry lock.
+        let before = std::fs::read(&registry).unwrap();
+        let memory = app.state.installed_plugins.clone();
+        let panes = app.state.plugin_panes.len();
+        app.state.agent_view_override = Some(view("plugin:example.manager"));
+        let candidate_manifest = scoped_root.join("herdr-plugin.toml");
+        let candidate_bytes = std::fs::read(&candidate_manifest).unwrap();
+        let nested = scoped_root.join("nested");
+        write_manifest(&nested, "New Scoped", "3.0.0");
+        for fresh in [false, true] {
+            let redirect = candidate_manifest.clone();
+            let target = nested.join("herdr-plugin.toml");
+            let retarget = move || {
+                std::fs::remove_file(&redirect).unwrap();
+                std::os::unix::fs::symlink(&target, &redirect).unwrap();
+            };
+            if fresh {
+                MANAGER_BEFORE_REGISTRY_TEST.with(|callback| {
+                    *callback.borrow_mut() = Some(Box::new(retarget));
+                });
+            } else {
+                retarget();
+            }
+            let response =
+                app.handle_plugin_manager_mutate("redirected-update".into(), update.clone());
+            let result: serde_json::Value = serde_json::from_str(&response).unwrap();
+            assert_eq!(result["error"]["code"], "plugin_manager_rejected");
+            assert!(result["error"]["message"]
+                .as_str()
+                .unwrap()
+                .contains("installed plugin manifest does not match the managed checkout source"));
+            assert_eq!(std::fs::read(&registry).unwrap(), before);
+            assert_eq!(app.state.installed_plugins, memory);
+            assert_eq!(app.state.plugin_panes.len(), panes);
+            assert_eq!(
+                app.state.agent_view_override.as_ref().unwrap().source,
+                "plugin:example.manager"
+            );
+            assert_eq!(
+                std::fs::read(backup.join("user-bytes")).unwrap(),
+                b"keep old checkout bytes"
+            );
+            std::fs::remove_file(&candidate_manifest).unwrap();
+            std::fs::write(&candidate_manifest, &candidate_bytes).unwrap();
+        }
+        let physical = checkout.join("physical-subdir");
+        std::fs::rename(&scoped_root, &physical).unwrap();
+        std::os::unix::fs::symlink(&physical, &scoped_root).unwrap();
+        let response = app.handle_plugin_manager_mutate("redirected-subdir".into(), update.clone());
+        let result: serde_json::Value = serde_json::from_str(&response).unwrap();
+        assert_eq!(result["error"]["code"], "plugin_manager_rejected");
+        assert_eq!(std::fs::read(&registry).unwrap(), before);
+        assert_eq!(app.state.installed_plugins, memory);
+        std::fs::remove_file(&scoped_root).unwrap();
+        std::fs::rename(&physical, &scoped_root).unwrap();
+        let response = app.handle_plugin_manager_mutate("scoped-update".into(), update);
+        let result: serde_json::Value = serde_json::from_str(&response).unwrap();
+        assert_eq!(result["result"]["type"], "plugin_manager_mutation");
+        let updated = crate::persist::plugin_registry::manager_inventory()
+            .unwrap()
+            .remove(0);
+        assert_eq!(updated.display.name, "New Scoped");
+        assert_eq!(updated.display.version, "3.0.0");
+        assert!(!updated.registration.enabled);
+        assert_eq!(
+            updated.registration.source.requested_ref.as_deref(),
+            Some("release")
+        );
+        assert_eq!(
+            updated.registration.source.subdir.as_deref(),
+            Some("@scope/space plugin")
+        );
+        assert_eq!(
+            std::fs::read(backup.join("user-bytes")).unwrap(),
+            b"keep old checkout bytes"
+        );
+        assert_eq!(
+            std::fs::read(user_config.join("keep")).unwrap(),
+            b"config bytes"
+        );
+        assert_eq!(
+            std::fs::read(user_state.join("keep")).unwrap(),
+            b"state bytes"
+        );
+        drop(lease);
+        match old_home {
+            Some(value) => std::env::set_var("XDG_CONFIG_HOME", value),
+            None => std::env::remove_var("XDG_CONFIG_HOME"),
+        }
+        match old_state_home {
+            Some(value) => std::env::set_var("XDG_STATE_HOME", value),
+            None => std::env::remove_var("XDG_STATE_HOME"),
+        }
+        std::fs::remove_dir_all(root).unwrap();
+    }
+}
