+/// Manager-only lock acquisition. Resolve the stow-compatible plugins directory
+/// first, then create/open the lock relative to a verified physical directory FD.
+#[cfg(unix)]
+pub(crate) fn lock_install_roots_guarded(protected_roots: &[String]) -> io::Result<std::fs::File> {
+    lock_manager_file_guarded(".plugin-install.lock", protected_roots)
+}
