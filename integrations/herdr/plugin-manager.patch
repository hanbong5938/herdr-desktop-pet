+// Never canonicalize `expected`: doing so would let a replaced recorded root
+// authorize a different profile. Only the live producer alias is resolved.
+#[cfg(unix)]
+struct ManagerConfigIdentity<'a> {
+    alias: &'a Path,
+    expected: &'a Path,
+    pinned_path: PathBuf,
+    pinned: std::fs::File,
+}
+
+#[cfg(unix)]
+impl<'a> ManagerConfigIdentity<'a> {
+    fn capture(alias: &'a Path, expected: &'a Path) -> io::Result<Self> {
+        if !expected.is_absolute()
+            || expected.components().any(|part| {
+                !matches!(
+                    part,
+                    std::path::Component::RootDir | std::path::Component::Normal(_)
+                )
+            })
+            || manager_physical_path(alias)? != expected
+        {
+            return Err(io::Error::other("original config identity changed"));
+        }
+        // Bootstrap may not have created the config directory yet. Pin its
+        // nearest existing ancestor without creating or syncing anything.
+        let mut pinned_path = expected.to_path_buf();
+        loop {
+            match std::fs::symlink_metadata(&pinned_path) {
+                Ok(_) => break,
+                Err(error) if error.kind() == io::ErrorKind::NotFound => {
+                    if !pinned_path.pop() {
+                        return Err(io::Error::other("missing config ancestor"));
+                    }
+                }
+                Err(error) => return Err(error),
+            }
+        }
+        let identity = Self {
+            alias,
+            expected,
+            pinned: Self::open_directory(&pinned_path)?,
+            pinned_path,
+        };
+        identity.verify()?;
+        Ok(identity)
+    }
+
+    fn open_directory(path: &Path) -> io::Result<std::fs::File> {
+        use std::os::unix::fs::OpenOptionsExt;
+        OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_CLOEXEC)
+            .open(path)
+    }
+
+    fn verify(&self) -> io::Result<()> {
+        if manager_physical_path(self.alias)? != self.expected {
+            return Err(io::Error::other("original config identity changed"));
+        }
+        manager_verify_parent(&self.pinned, &self.pinned_path)
+    }
+
+    fn pin_created_config(&mut self) -> io::Result<()> {
+        self.verify()?;
+        if self.pinned_path != self.expected {
+            self.pinned = Self::open_directory(self.expected)?;
+            self.pinned_path = self.expected.to_path_buf();
+        }
+        self.verify()
+    }
+}
