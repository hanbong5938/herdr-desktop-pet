+    #[cfg(any(target_os = "macos", target_os = "linux"))]
+    fn durable_fault_server(
+        listener: std::os::unix::net::UnixListener,
+        fault: crate::persist::plugin_registry::ManagerSyncStage,
+        rollback_inventory: bool,
+    ) -> std::thread::JoinHandle<()> {
+        std::thread::spawn(move || {
+            use std::io::BufRead;
+            let (_sender, receiver) = tokio::sync::mpsc::unbounded_channel();
+            let mut app = crate::app::App::new(
+                &crate::config::Config::default(),
+                crate::app::AppPolicy {
+                    persist_plugin_registry: true,
+                    ..crate::app::AppPolicy::TEST
+                },
+                None,
+                receiver,
+                crate::api::EventHub::default(),
+            );
+            let mut mutated = false;
+            for stream in listener.incoming() {
+                let mut reader = io::BufReader::new(stream.unwrap());
+                let mut line = String::new();
+                reader.read_line(&mut line).unwrap();
+                let request: Request = serde_json::from_str(&line).unwrap();
+                let mutation = matches!(request.method, Method::PluginManagerMutate(_));
+                let after_mutation = mutated;
+                let _fault = mutation.then(|| {
+                    crate::persist::plugin_registry::manager_sync_test(Some((fault, None)))
+                });
+                let response = app.handle_api_request(request);
+                if mutation {
+                    let value: Value = serde_json::from_str(&response).unwrap();
+                    assert_eq!(
+                        value["error"]["code"],
+                        match fault {
+                            crate::persist::plugin_registry::ManagerSyncStage::Destination =>
+                                "plugin_manager_registry_uncertain",
+                            _ => "plugin_manager_registry_failed",
+                        }
+                    );
+                }
+                mutated |= mutation;
+                let mut stream = reader.into_inner();
+                stream.write_all(response.as_bytes()).unwrap();
+                stream.write_all(b"\n").unwrap();
+                if (mutation && !rollback_inventory) || after_mutation {
+                    break;
+                }
+            }
+        })
+    }
