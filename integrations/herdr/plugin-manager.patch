+pub(crate) fn ensure_safe(
+    candidate_id: &str,
+    candidate_paths: &[&Path],
+    registrations: &[InstalledPluginInfo],
+    supplied_roots: &[String],
+) -> io::Result<()> {
+    if candidate_id == "desktop-pet" {
+        return Err(io::Error::other("desktop-pet is read-only"));
+    }
+    let mut roots = Vec::new();
+    for entry in registrations.iter().filter(|entry| protected(entry)) {
+        roots.push(resolved(Path::new(&entry.plugin_root))?);
+        if let Some(path) = &entry.source.managed_path {
+            roots.push(resolved(Path::new(path))?);
+        }
+    }
+    for path in supplied_roots {
+        roots.push(resolved(Path::new(path))?);
+    }
+    for candidate in candidate_paths {
+        let candidate = resolved(candidate)?;
+        if roots
+            .iter()
+            .any(|root| candidate.starts_with(root) || root.starts_with(&candidate))
+        {
+            return Err(io::Error::other(format!(
+                "plugin path {} overlaps read-only desktop-pet installation",
+                candidate.display()
+            )));
+        }
+    }
+    Ok(())
+}
