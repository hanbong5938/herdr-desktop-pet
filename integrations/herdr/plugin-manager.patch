+#[cfg(unix)]
+fn manager_update_at<T, E>(
+    alias: &Path,
+    lock_alias: &Path,
+    expected_config: &Path,
+    protected_roots: &[String],
+    mutation: impl FnOnce(&mut Vec<InstalledPluginInfo>) -> Result<T, E>,
