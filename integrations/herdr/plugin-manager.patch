+use std::path::{Path, PathBuf};
+
+use crate::api::schema::{
+    InstalledPluginInfo, PluginManagerAction, PluginManagerMutationParams,
+    PluginManagerReplacement, PluginSourceKind, ResponseResult,
+};
+use crate::app::App;
+use crate::persist::plugin_registry::ManagerRegistryError;
+use crate::plugin_manager_guard::{
+    ensure_installed_manifest_matches_checkout, ensure_safe, managed_manifest_root,
+    manager_config_root, resolved,
+};
+
+use super::super::responses::{encode_error, encode_success};
+use super::{load_plugin_manifest, normalize_plugin_source};
+
+#[cfg(test)]
+thread_local! {
+    // One-shot scheduling seam: tests can retarget a live profile alias after
+    // request prechecks, without changing production path or fault behavior.
+    static MANAGER_BEFORE_REGISTRY_TEST: std::cell::RefCell<Option<Box<dyn FnOnce()>>> =
+        std::cell::RefCell::new(None);
+}
+
+fn same_original_context(params: &PluginManagerMutationParams) -> bool {
+    let original = &params.original_context;
+    if original.pid != std::process::id() {
+        return false;
+    }
+    // Only the current config producer is normalized. Immutable captured roots
+    // and the state producer retain their strict absolute-path semantics.
+    manager_config_root().is_ok_and(|actual| Path::new(&original.config_dir) == actual)
+        && resolved(&crate::config::state_dir())
+            .is_ok_and(|actual| Path::new(&original.state_dir) == actual)
+}
+
+fn registration_paths(entry: &InstalledPluginInfo) -> Vec<&Path> {
+    let mut paths = vec![
+        Path::new(&entry.plugin_root),
+        Path::new(&entry.manifest_path),
+    ];
+    if let Some(managed) = entry.source.managed_path.as_deref() {
+        paths.push(Path::new(managed));
+    }
+    paths
+}
+
+fn previous_manifest(
+    current: &InstalledPluginInfo,
+    replacement: &PluginManagerReplacement,
+) -> Result<(InstalledPluginInfo, PathBuf, PathBuf), String> {
+    let managed = current
+        .source
+        .managed_path
+        .as_deref()
+        .ok_or("missing recorded managed checkout")?;
+    let original_root = managed_manifest_root(Path::new(managed), current.source.subdir.as_deref())
+        .map_err(|err| err.to_string())?;
+    ensure_installed_manifest_matches_checkout(current, &original_root)
+        .map_err(|_| "recorded manifest is outside the managed checkout layout".to_string())?;
+    let backup_path = Path::new(&replacement.previous_checkout);
+    if !backup_path.is_absolute()
+        || !std::fs::symlink_metadata(backup_path)
+            .is_ok_and(|metadata| metadata.file_type().is_dir())
+    {
+        return Err("preserved previous checkout must be a directory".into());
+    }
+    let backup = backup_path.canonicalize().map_err(|err| err.to_string())?;
+    let backup_root = managed_manifest_root(&backup, current.source.subdir.as_deref())
+        .map_err(|err| err.to_string())?;
+    let backup_manifest = backup_root.join("herdr-plugin.toml");
+    if !std::fs::symlink_metadata(&backup_root).is_ok_and(|metadata| metadata.file_type().is_dir())
+        || !std::fs::symlink_metadata(&backup_manifest)
+            .is_ok_and(|metadata| metadata.file_type().is_file())
+        || backup_root.canonicalize().map_err(|err| err.to_string())? != backup_root
+        || backup_manifest
+            .canonicalize()
+            .map_err(|err| err.to_string())?
+            != backup_manifest
+    {
+        return Err("preserved checkout manifest layout changed".into());
+    }
+    let mut old = load_plugin_manifest(&backup_manifest.display().to_string(), current.enabled)
+        .map_err(|(_, message)| message)?;
+    ensure_installed_manifest_matches_checkout(&old, &backup_root)
+        .map_err(|_| "preserved checkout manifest coordinates changed".to_string())?;
+    // Only the verified coordinates are mapped back. All other fields,
+    // including warnings, come from the preserved manifest's fresh parse.
+    old.plugin_root.clone_from(&current.plugin_root);
+    old.manifest_path.clone_from(&current.manifest_path);
+    old.source.clone_from(&current.source);
+    old.enabled = current.enabled;
+    Ok((old, backup, backup_manifest))
+}
+
+fn confirmed_display(current: &InstalledPluginInfo) -> InstalledPluginInfo {
+    crate::persist::plugin_registry::reload_manifests(vec![current.clone()], |path, enabled| {
+        load_plugin_manifest(path, enabled).map_err(|(_, err)| err)
+    })
+    .pop()
+    .unwrap()
+}
+
+impl App {
+    pub(crate) fn handle_plugin_manager_mutate(
+        &mut self,
+        id: String,
+        params: PluginManagerMutationParams,
+    ) -> String {
+        // Bind the request to this server BEFORE consulting a lease, creating
+        // registry files or touching any candidate checkout.
+        if !same_original_context(&params) {
+            return encode_error(
+                id,
+                "plugin_manager_rejected",
+                "original server context changed",
+            );
+        }
+        if let Err(err) = crate::plugin_manager_guard::verify_manager_lease(&params.lease_token) {
+            return encode_error(id, "plugin_manager_rejected", err.to_string());
+        }
+        let initial = match crate::persist::plugin_registry::manager_inventory() {
+            Ok(entries) => entries
+                .into_iter()
+                .map(|entry| entry.registration)
+                .collect::<Vec<_>>(),
+            Err(err) => return encode_error(id, "plugin_manager_registry_failed", err.to_string()),
+        };
+        let mut proposed_paths = registration_paths(&params.expected_registration);
+        proposed_paths.extend(registration_paths(&params.expected));
+        if let Some(replacement) = params.replacement.as_ref() {
+            proposed_paths.push(Path::new(&replacement.path));
+            proposed_paths.push(Path::new(&replacement.previous_checkout));
+        }
+        if let Err(err) = ensure_safe(
+            &params.expected.plugin_id,
+            &proposed_paths,
+            &initial,
+            &params.protected_roots,
+        ) {
+            return encode_error(id, "plugin_manager_rejected", err.to_string());
+        }
+        let replacement = match (params.action, params.replacement.as_ref()) {
+            (PluginManagerAction::Update, Some(replacement)) => {
+                let mut candidate =
