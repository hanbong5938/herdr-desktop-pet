+// Canonicalize the nearest existing ancestor as well: managed checkout destinations
+// and user-supplied bundle roots need not exist yet. Fail closed on dangling symlinks.
+pub(crate) fn resolved(path: &Path) -> io::Result<PathBuf> {
+    if !path.is_absolute() {
+        return Err(io::Error::other(format!(
+            "not an absolute path: {}",
+            path.display()
+        )));
+    }
+    let mut missing = Vec::new();
+    let mut ancestor = path;
+    while !ancestor.exists() {
+        if std::fs::symlink_metadata(ancestor).is_ok() {
+            return Err(io::Error::other("dangling symlink in protected path"));
+        }
+        let Some(name) = ancestor.file_name() else {
+            return Err(io::Error::other("invalid protected path"));
+        };
+        if name == ".." || name == "." {
+            return Err(io::Error::other("noncanonical protected path"));
+        }
+        missing.push(name.to_owned());
+        ancestor = ancestor
+            .parent()
+            .ok_or_else(|| io::Error::other("invalid protected path"))?;
+    }
+    let mut result = ancestor.canonicalize()?;
+    for name in missing.iter().rev() {
+        result.push(name);
+    }
+    Ok(result)
+}
