+            assert_eq!(install.metadata().unwrap().ino(), named.ino());
+            assert_eq!(install.metadata().unwrap().dev(), named.dev());
+            let contender = std::fs::File::open(
+                crate::plugin_paths::managed_plugins_dir().join(".plugin-install.lock"),
+            )
+            .unwrap();
+            assert_ne!(
+                unsafe { libc::flock(contender.as_raw_fd(), libc::LOCK_EX | libc::LOCK_NB) },
+                0
+            );
+            assert_eq!(io::Error::last_os_error().kind(), io::ErrorKind::WouldBlock);
+            drop(install);
+            let ordinary = lock_install_roots().unwrap();
+            assert_eq!(ordinary.metadata().unwrap().ino(), named.ino());
+            drop(ordinary);
+
+            let mut lease = lock_manager_lease_guarded(&[]).unwrap();
+            let token = "0123456789abcdef0123456789abcdef";
+            write!(lease, "{} {token}", std::process::id()).unwrap();
+            verify_manager_lease_lock_binding(&lease, &[]).unwrap();
+            verify_manager_lease(token).unwrap();
+            assert_eq!(
+                try_ordinary_mutation_admission().unwrap_err().kind(),
+                io::ErrorKind::WouldBlock
+            );
+            let physical_lease = plugins.join(".manager.lock").metadata().unwrap();
+            assert_eq!(lease.metadata().unwrap().ino(), physical_lease.ino());
+
+            let wrong_cwd = base.join("wrong-cwd");
