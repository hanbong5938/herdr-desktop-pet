+fn manager_inventory_at(path: &Path) -> io::Result<Vec<PluginManagerInventoryEntry>> {
+    let registrations = manager_read_raw(path)?;
+    let display = reload_manifests(registrations.clone(), |path, enabled| {
+        crate::app::api::plugins::load_plugin_manifest(path, enabled)
+            .map_err(|(_, message)| message)
+    });
+    Ok(display
+        .into_iter()
+        .zip(registrations)
+        .map(|(display, registration)| PluginManagerInventoryEntry {
+            display,
+            registration,
+        })
