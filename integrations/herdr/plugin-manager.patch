+        let (display, physical_backup, manifest) = previous_manifest(&raw, &update).unwrap();
+        assert_eq!(display, expected);
+        assert_eq!(display.name, "Confirmed Old");
+        assert_eq!(display.version, "2.0.0");
+        assert_eq!(display.source, raw.source);
