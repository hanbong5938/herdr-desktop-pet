+fn manager_read_raw(path: &Path) -> io::Result<Vec<InstalledPluginInfo>> {
+    match std::fs::symlink_metadata(path) {
+        Ok(_) => {}
+        Err(err) if err.kind() == io::ErrorKind::NotFound => {
+            // Missing ordinary directories mean an empty registry; a dangling
+            // symlink in the path is instead an unreadable registry.
+            manager_physical_path(path)?;
+            return Ok(Vec::new());
+        }
+        Err(err) => return Err(err),
+    }
+    let contents = std::fs::read_to_string(path)?;
+    serde_json::from_str(&contents).map_err(|err| io::Error::new(io::ErrorKind::InvalidData, err))
+}
