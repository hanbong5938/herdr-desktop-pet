+    let file = lock_manager_file_guarded(".manager.lock", protected_roots)?;
+    use std::os::unix::fs::PermissionsExt;
+    file.set_permissions(std::fs::Permissions::from_mode(0o600))?;
+    verify_manager_lease_lock_binding(&file, protected_roots)?;
+    Ok(file)
+}
