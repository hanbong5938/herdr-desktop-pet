+pub(crate) fn validate_github_subdir_segment(value: &str) -> Result<(), String> {
+    if value.is_empty() || value == "." || value == ".." || value.contains(['/', '\\', '\0', ':']) {
+        return Err(format!("invalid plugin subdir segment: {value}"));
+    }
+    Ok(())
