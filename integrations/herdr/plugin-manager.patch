+/// Resolve the checkout only. Recorded subdirectories remain lexical so a
+/// redirected manifest or subdirectory cannot silently change its coordinates.
+pub(crate) fn managed_manifest_root(checkout: &Path, subdir: Option<&str>) -> io::Result<PathBuf> {
+    if !checkout.is_absolute() || !std::fs::symlink_metadata(checkout)?.file_type().is_dir() {
+        return Err(io::Error::other(
+            "managed checkout must be a physical directory",
+        ));
+    }
+    let mut root = checkout.canonicalize()?;
+    if let Some(subdir) = subdir {
+        for segment in subdir.split('/') {
+            validate_github_subdir_segment(segment).map_err(io::Error::other)?;
+        }
+        root.push(subdir);
+    }
+    Ok(root)
+}
