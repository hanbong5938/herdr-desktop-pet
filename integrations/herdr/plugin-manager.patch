+/// Only the checkout's parent may be an alias (for example macOS /var).
+/// Never follow a symlink at either checkout leaf for a destructive operation.
+pub(crate) fn same_managed_checkout(stored: &Path, expected: &Path) -> bool {
+    fn real_directory(path: &Path) -> Option<PathBuf> {
+        if !path.is_absolute() || !std::fs::symlink_metadata(path).ok()?.file_type().is_dir() {
+            return None;
+        }
+        path.canonicalize().ok()
+    }
+    match (real_directory(stored), real_directory(expected)) {
+        (Some(stored), Some(expected)) => stored == expected,
+        _ => false,
+    }
+}
