+#[cfg(not(unix))]
+pub(crate) fn lock_manager_lease_guarded(_protected_roots: &[String]) -> io::Result<std::fs::File> {
+    Err(io::Error::new(
+        io::ErrorKind::Unsupported,
+        "plugin manager mutations require a Unix host",
