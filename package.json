{
  "name": "herdr-desktop-pet-integration",
  "private": true,
  "type": "module",
  "description": "Herdr adapter, plugin consumer and OMP outcome integration for Desktop Pet",
  "scripts": {
    "check": "tsc --noEmit",
    "verify": "bash scripts/verify-integration.sh",
    "test:adapter": "cargo test --locked --manifest-path native-adapter/Cargo.toml",
    "release:check": "bun scripts/integration-release.ts check",
    "release:publish": "bun scripts/integration-release.ts publish"
  },
  "devDependencies": {
    "@types/bun": "^1.2.20",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.2"
  }
}
